.mask { position: fixed; inset: 0; z-index: 1000; background: rgba(40,32,24,.45); display: flex; align-items: center; justify-content: center; padding: 42rpx; }
.dialog { width: 100%; background: var(--lm-paper); border-radius: 32rpx; padding: 40rpx; }.heading { font-size: 32rpx; font-weight: 600; }.copy { font-size: 26rpx; color: var(--lm-muted); line-height: 1.8; margin: 24rpx 0; }.policy { color: var(--lm-accent); font-size: 24rpx; padding: 16rpx 0; }.actions { display: flex; gap: 20rpx; margin-top: 22rpx; }.action { flex: 1; font-size: 24rpx; padding: 20rpx 10rpx; border-radius: 16rpx; background: var(--lm-soft); }.actions .agree { background: var(--lm-accent); color: var(--lm-paper); }

.dialog { background: var(--lm-bg); color: var(--lm-ink); font-family: inherit; }.actions .agree { background: var(--lm-accent); color: var(--lm-on-accent); }
