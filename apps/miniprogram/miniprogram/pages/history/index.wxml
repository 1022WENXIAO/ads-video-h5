<view class="theme-surface theme-{{theme}}"><view class="screen">
<view class="page-heading"><text>会话历史</text><button size="mini" class="secondary" bindtap="create" disabled="{{busy}}">＋ 新对话</button></view>
<view wx:if="{{!guest && !managementAvailable}}" class="notice">当前连接的版本暂不支持归档和删除；本地试用版可体验完整功能。</view>
<input class="input" placeholder="搜索对话标题" value="{{query}}" bindinput="search"/>
<view class="history-filters"><button size="mini" class="{{filter === 'all' ? 'chosen' : ''}}" bindtap="filter" data-filter="all">全部</button><button size="mini" class="{{filter === 'chat' ? 'chosen' : ''}}" bindtap="filter" data-filter="chat">对话</button><button size="mini" class="{{filter === 'work' ? 'chosen' : ''}}" bindtap="filter" data-filter="work">工作</button><button size="mini" class="{{archived ? 'chosen' : ''}}" bindtap="toggleArchive">{{archived ? '返回未归档' : '已归档'}}</button></view>
<view wx:if="{{!sessions.length}}" class="empty"><text class="title">{{archived ? '还没有归档对话' : '这里还没有对话'}}</text><text class="muted">{{query ? '换个关键词试试' : '开始聊聊，或一起梳理想完成的工作。'}}</text></view>
<view wx:for="{{sessions}}" wx:key="id" class="session panel {{item.selected ? 'selected' : ''}}" bindtap="activate" data-id="{{item.id}}">
<view class="session-open"><view class="row spread"><text class="title">{{item.title}}</text><text class="tag">{{item.running ? '进行中' : item.selected ? '当前' : item.modeLabel}}</text></view><text class="date">{{item.date}} · {{item.count}} 条消息 · {{item.modeLabel}}</text></view>
<view class="session-actions" catchtap="noop"><button size="mini" catchtap="archive" data-id="{{item.id}}" disabled="{{busy || item.running || !managementAvailable}}">{{item.archived ? '取消归档' : '归档'}}</button><button size="mini" catchtap="remove" data-id="{{item.id}}" disabled="{{busy || item.running || !managementAvailable}}">删除</button></view>
</view><button size="mini" wx:if="{{more}}" class="secondary" bindtap="more">加载更多</button>
</view><privacy-dialog id="privacy"/></view>
