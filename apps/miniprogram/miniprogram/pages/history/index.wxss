.session { width: 100%; text-align: left; }.session .title { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; max-width: 500rpx; }.session.selected { border-color: var(--lm-line); background: var(--lm-paper); }

.history-filters { display:flex; margin:24rpx 0; flex-wrap:wrap; }.history-filters button { margin:0 12rpx 12rpx 0; width:auto; padding:12rpx 22rpx; font-size:24rpx; border-radius:30rpx; color:var(--lm-muted); }.history-filters .chosen { background:var(--lm-soft); color:var(--lm-accent); }.session-open { display:block; width:100%; padding:0; margin:0; text-align:left; }.session-open .title { flex:1; min-width:0; }.session-actions { display:flex; justify-content:flex-end; border-top:1rpx solid var(--lm-line); margin-top:18rpx; padding-top:12rpx; }.session-actions button { width:auto; margin:0 0 0 24rpx; padding:8rpx 12rpx; font-size:23rpx; color:var(--lm-muted); }