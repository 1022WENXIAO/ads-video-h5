<view class="theme-surface theme-{{theme}}">
<view class="screen"><view wx:if="{{item}}"><view class="player-title">{{item.name}}</view><text class="date">{{item.date}} {{item.duration}}</text><view class="preview"><video wx:if="{{src && item.kind === 'video'}}" src="{{src}}" controls show-center-play-btn enable-play-gesture binderror="mediaError" object-fit="contain" /><image wx:if="{{src && item.kind === 'image'}}" src="{{src}}" mode="widthFix" bindtap="image" binderror="mediaError" /><view wx:if="{{src && item.kind === 'audio'}}" class="audio-player"><text class="audio-mark">♫</text><text class="muted">{{elapsed}} / {{duration || item.duration}} 秒</text><button size="mini" class="secondary" bindtap="toggleAudio">{{playing ? '暂停' : '播放音频'}}</button></view><view wx:if="{{loading}}" class="loading">正在加载文件…</view></view><view wx:if="{{error}}" class="error">{{error}}</view><button size="mini" wx:if="{{error}}" class="secondary" bindtap="retry"><image class="ui-icon" src="{{icons.retry}}" mode="aspectFit"/>重新加载</button><button size="mini" wx:if="{{item.kind !== 'audio'}}" class="primary save-button" loading="{{saving}}" disabled="{{saving || loading}}" bindtap="save"><image class="ui-icon" src="{{onPrimary.download}}" mode="aspectFit"/>保存到手机相册</button><view wx:if="{{isMedia}}" class="row player-actions"><button size="mini" class="secondary grow" bindtap="use"><image class="ui-icon" src="{{icons.create}}" mode="aspectFit"/>用来创作</button><button size="mini" wx:if="{{item.kind !== 'image'}}" class="secondary grow" bindtap="analyze" disabled="{{analyzing}}" loading="{{analyzing}}">理解原声</button></view><view wx:if="{{analysis}}" class="panel transcript"><view class="section-title">原声文字</view><text selectable>{{analysis}}</text></view></view><view wx:else class="error">{{error || '正在读取文件…'}}</view></view><privacy-dialog id="privacy" />
</view>
