.source-choice { margin-top:24rpx; display:flex; justify-content:space-between; }.film-actions { flex-wrap:wrap; margin:20rpx 0; }.film-summary { display:flex; flex-direction:column; gap:14rpx; margin:28rpx 0; color:var(--lm-accent); }.shot-card { margin-top:24rpx; }.shot-cover { display:block; width:100%; height:300rpx; border-radius:18rpx; margin-bottom:16rpx; }.shot-heading { font-size:24rpx; color:var(--lm-muted); margin-bottom:12rpx; }.shot-tags { font-size:22rpx; color:var(--lm-muted); margin:12rpx 0; }.quote { font-size:25rpx; padding:16rpx; background:var(--lm-soft); margin:16rpx 0; border-radius:14rpx; }.usage { font-size:26rpx; margin:16rpx 0; line-height:1.7; }.film-preview video { width:100%; height:400rpx; }.film-mask { position:fixed; inset:0; background:rgba(40,31,23,.3); z-index:100; display:flex; align-items:flex-end; }.film-sheet { width:100%; padding:30rpx 32rpx calc(24rpx + env(safe-area-inset-bottom)); background:var(--lm-paper); border-radius:30rpx 30rpx 0 0; }.film-sheet>button { width:100%; margin-top:18rpx; }
