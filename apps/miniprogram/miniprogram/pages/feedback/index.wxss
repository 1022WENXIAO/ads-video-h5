.feedback-screen { text-align: center; padding-top: 70rpx; }.feedback-screen .page-heading { justify-content: center; margin-top: 32rpx; }.feedback-card { padding: 50rpx 30rpx; }.feedback-card .title { margin: 20rpx 0; }.feature-icon { width: 80rpx; height: 80rpx; }
.feedback-contact { text-align: left; padding: 24rpx 0; border-bottom: 1rpx solid var(--lm-line); }.feedback-contact .link-row { width: 100%; min-width: 0; margin: 0; padding: 0; border: 0; text-align: left; }.feedback-contact .grow { min-width: 0; }.contact-label { font-size: 25rpx; line-height: 1.6; }.contact-value { color: var(--lm-accent); font-size: 32rpx; margin-top: 8rpx; }.contact-action { flex-shrink: 0; color: var(--lm-accent); font-size: 23rpx; margin-left: 18rpx; }.contact-hint { font-size: 23rpx; line-height: 1.8; margin-top: 14rpx; }.feedback-thanks { margin-top: 28rpx; font-size: 23rpx; }
