<view class="theme-surface theme-{{theme}}"><view class="screen feedback-screen"><view class="cat-medallion"><image src="/assets/lightmao-logo.png" mode="aspectFit" aria-label="轻喵LightMao" /></view><view class="page-heading"><text>联系轻喵</text></view><view class="panel feedback-card"><image class="feature-icon" src="{{icons.newChat}}" mode="aspectFit"/><block wx:if="{{!contacts.length}}"><view class="title">反馈渠道准备中</view><view class="muted">后续将在这里提供我们的联系方式。<view>感谢你帮助轻喵变得更好。</view></view></block><block wx:else><view class="title">欢迎告诉我们你的建议</view><view class="feedback-contact" wx:for="{{contacts}}" wx:key="id"><button size="mini" class="link-row" bindtap="copyContact" data-id="{{item.id}}"><view class="grow"><view class="contact-label">{{item.label}}</view><view class="contact-value">{{item.value}}</view></view><text class="contact-action">{{item.action || '复制'}}</text></button><view wx:if="{{item.hint}}" class="muted contact-hint">{{item.hint}}</view></view><view class="muted feedback-thanks">感谢你帮助轻喵变得更好。</view></block></view></view></view>
