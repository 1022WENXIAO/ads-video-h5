<view class="theme-surface theme-{{theme}}">
<view class="screen"><view class="page-heading"><text>我的素材<text class="count">{{count}}</text></text><button size="mini" class="secondary" bindtap="upload" loading="{{uploading}}" disabled="{{uploading}}"><image class="ui-icon" src="{{onPrimary.upload}}" mode="aspectFit"/>添加</button></view><view class="subtitle">图片和视频可混选，也可分批追加。</view><button size="mini" class="small-button live-help" bindtap="livePhotoHelp">如何导入实况照片？</button><view class="filters"><button size="mini" class="{{filter === 'all' ? 'selected' : ''}}" data-kind="all" bindtap="filter">全部</button><button size="mini" class="{{filter === 'video' ? 'selected' : ''}}" data-kind="video" bindtap="filter">视频</button><button size="mini" class="{{filter === 'image' ? 'selected' : ''}}" data-kind="image" bindtap="filter">图片</button><button size="mini" class="{{filter === 'audio' ? 'selected' : ''}}" data-kind="audio" bindtap="filter">音频</button></view><view wx:if="{{uploading}}" class="notice">{{uploadText}}</view>
  <view wx:if="{{!items.length}}" class="empty"><image class="empty-mark empty-icon" src="{{icons.library}}" mode="aspectFit"/><text class="title">把素材带进来</text><view class="muted">添加视频、图片或音频，让轻喵LightMao帮你剪出故事。<view>也可以直接到创作页描述主题。</view></view></view>
  <view class="card-grid"><view wx:for="{{items}}" wx:key="id" class="media-tile"><view bindtap="play" data-id="{{item.id}}"><image wx:if="{{item.cover}}" class="media-cover" src="{{item.cover}}" mode="aspectFill" lazy-load data-id="{{item.id}}" binderror="coverError" /><view wx:else class="media-cover media-placeholder"><view class="placeholder-sun"/><view class="placeholder-hill"/><image class="placeholder-icon" src="{{item.kind === 'video' ? placeholderIcons.films : item.kind === 'audio' ? placeholderIcons.voice : placeholderIcons.library}}" mode="aspectFit"/><text>{{item.kind === 'video' ? '视频' : item.kind === 'audio' ? '音频' : '图片'}}</text></view><button size="mini" wx:if="{{item.coverError}}" class="small-button" catchtap="retryCover">重试缩略图</button><view class="media-info"><text class="media-name">{{item.name}}</text><text class="muted">{{item.duration}}</text><text class="date">{{item.date}}</text></view></view><view class="media-actions"><button size="mini" class="small-button" bindtap="use" data-id="{{item.id}}">用来创作 ↗</button><button size="mini" class="delete-button" bindtap="remove" data-id="{{item.id}}">删除</button></view></view></view><button size="mini" wx:if="{{more}}" class="secondary load-more" bindtap="more">加载更多</button>
</view><privacy-dialog id="privacy" />
</view>
