.count { margin-left: 16rpx; color: var(--lm-muted); font-size: 24rpx; font-weight: 400; }.filters { display: flex; gap: 16rpx; margin: 28rpx 0; }.filters button { padding: 12rpx 26rpx; color: var(--lm-muted); font-size: 24rpx; }.filters .selected { background: var(--lm-soft); color: var(--lm-accent); border-radius: 30rpx; }.delete-button { color: var(--lm-muted); font-size: 20rpx; padding: 10rpx; }.load-more { margin: 30rpx auto; }.media-info { min-height: 130rpx; }
.collection-tabs { display:flex; flex-wrap:wrap; gap:12rpx; margin-bottom:18rpx; }.collection-tabs button { margin:0; padding:10rpx 18rpx; color:var(--lm-muted); border:1rpx solid var(--lm-line); border-radius:24rpx; font-size:23rpx; }.collection-tabs .selected { color:var(--lm-on-accent); background:var(--lm-accent); }.film-entry { width:100%; padding:20rpx; margin:0 0 24rpx; text-align:left; color:var(--lm-accent); background:var(--lm-soft); border-radius:20rpx; }.film-entry text { display:block; font-size:22rpx; color:var(--lm-muted); }.collection-note { margin-bottom:20rpx; }.media-search { margin-bottom:18rpx; }.clip-tags { font-size:20rpx; color:var(--lm-muted); margin-top:8rpx; }.theme-surface .media-actions { flex-wrap:wrap; justify-content:flex-start; gap:0 14rpx; }.theme-surface .media-name { white-space:normal; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; }
