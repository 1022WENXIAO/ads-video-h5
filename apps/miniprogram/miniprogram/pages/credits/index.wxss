.balance-card { padding: 40rpx; border: 1rpx solid var(--lm-line); border-radius: 40rpx; background: linear-gradient(125deg,var(--lm-soft),var(--lm-soft)); margin-bottom: 30rpx; }.balance { font-size: 70rpx; font-weight: 600; color: var(--lm-ink); margin: 20rpx 0 12rpx; }.balance text { font-size: 24rpx; font-weight: 400; margin-left: 14rpx; color: var(--lm-muted); }.balance-foot { border-top: 1rpx solid var(--lm-line); padding-top: 26rpx; margin-top: 32rpx; color: var(--lm-muted); font-size: 21rpx; }.checkin-panel { padding: 38rpx; }.daily-value { text-align: center; padding: 40rpx 0; font-size: 56rpx; font-weight: 600; color: var(--lm-muted); }.daily-value text { font-size: 23rpx; font-weight: 400; margin-left: 12rpx; }.checkin-hint { text-align: center; margin-top: 18rpx; }.welcome-gift { padding: 2rpx 6rpx 10rpx; }.welcome-gift .quiet { margin: 9rpx 0 0 28rpx; }.ledger { padding: 0 26rpx; }.entry { padding: 26rpx 0; border-bottom: 1rpx solid var(--lm-line); font-size: 24rpx; }.entry:last-child { border: 0; }.entry-icon { background: var(--lm-soft); color: var(--lm-muted); width: 60rpx; height: 60rpx; text-align: center; line-height: 60rpx; border-radius: 18rpx; flex-shrink: 0; }.entry-value { font-size: 25rpx; white-space: nowrap; }.entry .plus { color: var(--lm-muted); }
.reward-mask { position: fixed; inset: 0; background: rgba(45,34,20,.48); z-index: 50; display: flex; align-items: center; justify-content: center; padding: 32rpx; }.reward-card { position: relative; width: 100%; max-width: 670rpx; max-height: 90vh; overflow-y: auto; background: radial-gradient(ellipse at 50% 36%,var(--lm-soft),transparent 60%),linear-gradient(var(--lm-soft),var(--lm-soft)); border: 1rpx solid var(--lm-line); border-radius: 44rpx; padding: 55rpx 42rpx 36rpx; text-align: center; box-shadow: 0 24rpx 90rpx rgba(40,29,16,.2); animation: arrive .25s ease-out; }.reward-close { position: absolute; top: 16rpx; right: 20rpx; color: var(--lm-muted); width: 50rpx; height: 50rpx; font-size: 40rpx; }.reward-ribbon { display: inline-block; font-size: 21rpx; border: 1rpx solid var(--lm-line); border-radius: 30rpx; padding: 8rpx 18rpx; color: var(--lm-muted); }.reward-date { margin-top: 24rpx; }.reward-art { position: relative; height: 290rpx; margin: 8rpx 0; display: flex; align-items: center; justify-content: center; }.halo { position: absolute; width: 270rpx; height: 270rpx; border: 1rpx solid var(--lm-line); border-radius: 50%; box-shadow: 0 0 0 26rpx rgba(246,213,155,.12); }.coin-front,.coin-back { position: absolute; background: linear-gradient(140deg,var(--lm-soft),var(--lm-gold)); border: 9rpx solid var(--lm-line); border-radius: 50%; color: var(--lm-accent); box-shadow: inset 0 0 0 3rpx var(--lm-line),0 14rpx 0 var(--lm-line),0 25rpx 35rpx rgba(156,105,34,.15); display: flex; align-items: center; justify-content: center; }.coin-front { width: 176rpx; height: 176rpx; font-size: 76rpx; transform: rotate(-8deg); animation: float 3s ease-in-out infinite; }.coin-back { width: 112rpx; height: 112rpx; margin: 80rpx 0 0 196rpx; font-size: 48rpx; opacity: .65; }.spark-one,.spark-two { position: absolute; color: var(--lm-muted); font-size: 44rpx; }.spark-one { top: 80rpx; left: 45rpx; }.spark-two { top: 56rpx; right: 70rpx; font-size: 32rpx; }.reward-title { color: var(--lm-accent); font-size: 30rpx; font-weight: 600; margin-top: 20rpx; }.reward-value { font-size: 70rpx; font-weight: 600; color: var(--lm-accent); margin: 24rpx 0 20rpx; }.reward-value text { font-size: 23rpx; font-weight: 400; margin-left: 12rpx; }.reward-button { background: linear-gradient(90deg,var(--lm-gold),var(--lm-muted)); margin-top: 36rpx; color: var(--lm-accent); }.reward-foot { margin-top: 24rpx; }.claimed .coin-front { animation: pop .45s ease-out; }
@keyframes arrive { from { opacity: 0; transform: translateY(18rpx) scale(.96); } to { opacity: 1; transform: translateY(0) scale(1); } }@keyframes float { 0%,100% { transform: translateY(0) rotate(-8deg); } 50% { transform: translateY(-10rpx) rotate(-4deg); } }@keyframes pop { 0% { transform: scale(.8); } 60% { transform: scale(1.08); } 100% { transform: scale(1); } }
