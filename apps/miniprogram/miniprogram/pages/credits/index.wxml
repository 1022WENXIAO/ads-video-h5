<view class="theme-surface theme-{{theme}}">
<view class="screen credit-screen">
  <view wx:if="{{guest}}" class="panel"><view class="title">积分与签到</view><view class="muted">登录后可查看个人积分及领取每日签到奖励。</view><button size="mini" class="primary" bindtap="login"><image class="ui-icon" src="{{onPrimary.profile}}" mode="aspectFit"/>选择微信登录</button></view>
  <view wx:if="{{wallet}}" class="balance-card"><view class="row spread"><text class="muted">创作积分</text><text wx:if="{{wallet.special}}" class="tag">特殊账户</text></view><view class="balance">{{wallet.balanceText}}<text>积分</text></view><view class="muted">把灵感，变成下一支好视频。</view><view class="balance-foot row spread"><text>1 积分 = ¥0.001</text><text>累计使用 {{wallet.spentText}}</text></view></view>
  <view wx:if="{{wallet}}" class="panel checkin-panel"><view class="row spread"><view><view class="title">每日签到</view><view class="quiet">每天一份，给创作充充电。</view></view><text class="tag">{{wallet.checkInDate}}</text></view><view class="daily-value">✧ +{{wallet.dailyText}}<text>积分</text></view><button size="mini" class="primary" disabled="{{!wallet.canCheckIn}}" bindtap="open">{{wallet.canCheckIn ? '签到，开启今日礼包 →' : '今日已领取 ✓'}}</button><view class="checkin-hint quiet">{{wallet.canCheckIn ? '签到后点击领取，积分才会到账。' : '明天 00:00（北京时间）再来领取。'}}</view></view>
  <view class="welcome-gift"><view class="muted">✧ 新朋友的第一份礼物</view><view class="quiet">首次注册即获 2,000.00 积分，自动到账。</view></view>
  <view class="section-title">积分明细</view><view class="panel ledger"><view class="entry row" wx:for="{{entries}}" wx:key="id"><view class="entry-icon">{{item.positive ? '礼' : '✧'}}</view><view class="grow"><view>{{item.label}}</view><text class="date">{{item.date}}</text><view wx:if="{{item.usage}}" class="quiet">{{item.usage}}</view></view><text class="entry-value {{item.positive ? 'plus' : ''}}">{{item.amount}}</text></view><view wx:if="{{loading}}" class="loading">正在读取明细…</view></view><button size="mini" wx:if="{{entries.length < total}}" class="small-button" bindtap="more" disabled="{{loading}}">查看更多</button>
  <view class="quiet">每天按北京时间可领取一次，未签到的日期不补领，已领取积分可累计。积分不足时，已开始的制作任务仍会继续完成。</view>
</view>
<view wx:if="{{modal}}" class="reward-mask" bindtap="close" catchtouchmove="noop"><view class="reward-card {{claimed ? 'claimed' : ''}}" catchtap="noop"><button size="mini" class="reward-close" bindtap="close" disabled="{{claiming}}">×</button><view class="reward-ribbon">✧ 轻喵LightMao · 每日签到礼包</view><view class="quiet reward-date">{{reward.day}}</view><view class="reward-art"><view class="halo"></view><view class="coin-back">✧</view><view class="coin-front">{{claimed || already ? '✓' : '礼'}}</view><text class="spark-one">✧</text><text class="spark-two">✧</text></view><view class="reward-title">{{claimed ? '今日灵感，已到账' : already ? '今日奖励已领取' : '为今天的创作，添点灵感'}}</view><view class="reward-value">{{claimed ? '+' : ''}}{{reward.amount}}<text>积分</text></view><view class="quiet">{{claimed ? '签到成功，积分已经加入你的余额。' : already ? '这个礼包已经领过啦，余额已同步。' : '点击领取，收下今天的创作能量。'}}</view><view wx:if="{{error}}" class="error">{{error}}</view><button size="mini" wx:if="{{claimed || already || expired}}" class="primary reward-button" bindtap="close">{{expired ? '返回积分页' : '收下礼包 →'}}</button><button size="mini" wx:else class="primary reward-button" bindtap="claim" loading="{{claiming}}" disabled="{{claiming}}">{{claiming ? '正在领取…' : '领取积分 →'}}</button><view class="quiet reward-foot">每日一份 · 积分可累计</view></view></view><privacy-dialog id="privacy" />
</view>
