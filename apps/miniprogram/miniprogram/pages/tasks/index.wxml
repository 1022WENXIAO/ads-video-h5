<view class="theme-surface theme-{{theme}}"><view class="screen">
<view class="page-heading"><text>定时任务</text><button size="mini" class="secondary" bindtap="refresh" disabled="{{busy}}">刷新</button></view>
<view class="muted task-intro">按北京时间执行，结果保存在轻喵的工作记录中。执行会使用账号积分；暂停后不再启动新任务。</view>
<view wx:if="{{error}}" class="error">{{error}}</view>
<view class="panel task-form"><view class="title">安排一件事</view><input class="input" placeholder="任务名称" maxlength="60" value="{{title}}" data-field="title" bindinput="field"/><textarea class="input task-prompt" placeholder="例如：查证今天的 AI 新闻，整理三条带来源的简报。" maxlength="2000" value="{{prompt}}" data-field="prompt" bindinput="field"/>
<view class="row"><picker mode="date" value="{{date}}" bindchange="date"><view class="task-picker">{{date}} ▾</view></picker><picker mode="time" value="{{time}}" bindchange="time"><view class="task-picker">{{time}} ▾</view></picker></view>
<view class="row"><picker range="{{frequencies}}" value="{{frequencyIndex}}" bindchange="frequency"><view class="task-picker">{{frequencies[frequencyIndex]}} ▾</view></picker><picker range="{{interactions}}" value="{{interactionIndex}}" bindchange="interaction"><view class="task-picker">{{interactions[interactionIndex]}} ▾</view></picker></view>
<button size="mini" class="primary" bindtap="create" loading="{{busy}}" disabled="{{busy || guest}}">保存定时任务</button><view class="quiet">任务内容按当前可用模型执行。结果仅在轻喵内保存。</view></view>
<view wx:if="{{!tasks.length}}" class="empty">还没有定时任务</view>
<view wx:for="{{tasks}}" wx:key="id" class="panel task-card"><view class="row spread"><text class="title">{{item.title}}</text><text class="tag">{{item.enabled ? '已启用' : '已暂停 / 已结束'}}</text></view><text class="task-description">{{item.prompt}}</text><view class="muted">{{item.frequencyLabel}} · 下次 {{item.nextTime}}</view><view class="row task-actions"><button size="mini" class="secondary" bindtap="toggle" data-id="{{item.id}}" data-enabled="{{item.enabled}}" disabled="{{busy}}">{{item.enabled ? '暂停' : '启用'}}</button><button size="mini" class="small-button" bindtap="remove" data-id="{{item.id}}" disabled="{{busy}}">删除</button></view>
<view wx:for="{{item.runs}}" wx:for-item="run" wx:key="id" class="task-run"><view>{{run.time}} · {{run.label}}</view><text wx:if="{{run.error}}" class="error">{{run.error}}</text><button size="mini" wx:if="{{run.sessionId}}" class="small-button" bindtap="open" data-id="{{run.sessionId}}">查看执行对话 →</button></view></view>
</view><privacy-dialog id="privacy"/></view>