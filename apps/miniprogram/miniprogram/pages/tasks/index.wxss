.task-intro{font-size:25rpx;line-height:1.8;margin-bottom:24rpx}.task-form .input{margin:20rpx 0;width:100%;box-sizing:border-box}.task-prompt{height:160rpx}.task-form .row{flex-wrap:wrap}.task-picker{padding:18rpx;background:var(--lm-soft);border-radius:14rpx;margin:0 12rpx 18rpx 0;font-size:25rpx}.task-description{display:block;white-space:pre-wrap;margin:18rpx 0;font-size:26rpx;line-height:1.8}.task-actions{margin-top:18rpx}.task-run{border-top:1rpx solid var(--lm-line);padding-top:18rpx;margin-top:18rpx;font-size:23rpx;color:var(--lm-muted)}.task-run .small-button{margin:10rpx 0 0;width:auto}