.auth-screen { padding-top: 60rpx; }.auth-intro { margin: 70rpx 0 40rpx; }.auth-title { font-size: 48rpx; font-weight: 600; margin-bottom: 18rpx; }.welcome-card { padding: 42rpx 34rpx; margin: 0 0 42rpx; border-radius: 30rpx; background: var(--lm-soft); border: 1rpx solid var(--lm-line); }.welcome-points { font-size: 68rpx; font-weight: 600; color: var(--lm-muted); }.welcome-unit { font-size: 25rpx; font-weight: 400; margin-left: 15rpx; }.welcome-label { margin-top: 10rpx; color: var(--lm-muted); font-size: 28rpx; }.welcome-detail { margin-top: 22rpx; color: var(--lm-muted); font-size: 24rpx; }.wechat-login { width: 100%; }.auth-hint { margin: 24rpx 0 42rpx; text-align: center; }.auth-legal { justify-content: center; margin-top: 20rpx; }.auth-legal-link { color: var(--lm-muted); font-size: 22rpx; padding: 10rpx; }
.auth-brand { display: flex; flex-direction: row; align-items: center; gap: 16rpx; margin-bottom: 12rpx; font-size: 36rpx; font-weight: 600; }
.auth-logo { width: 100rpx; height: 100rpx; flex: 0 0 100rpx; }
