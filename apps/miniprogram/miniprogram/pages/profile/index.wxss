.profile-top { display: flex; align-items: center; gap: 25rpx; margin: 20rpx 0 40rpx; }.profile-avatar { width: 98rpx; height: 98rpx; display: flex; align-items: center; justify-content: center; border-radius: 30rpx; background: var(--lm-soft); color: var(--lm-accent); font-size: 40rpx; font-weight: 600; }.profile-name { font-size: 36rpx; font-weight: 600; margin-bottom: 8rpx; }.stats { display: flex; justify-content: space-around; margin-bottom: 46rpx; }.stats view { text-align: center; }.stats text { display: block; font-size: 23rpx; color: var(--lm-muted); }.stats text:first-child { font-size: 38rpx; color: var(--lm-ink); margin-bottom: 8rpx; }.wallet-card { width: 100%; display: flex; align-items: center; justify-content: space-between; background: var(--lm-soft); border: 1rpx solid var(--lm-line); padding: 30rpx; border-radius: 28rpx; margin-bottom: 32rpx; text-align: left; }.wallet-label { display: block; font-size: 23rpx; color: var(--lm-muted); }.wallet-balance { display: block; font-size: 44rpx; color: var(--lm-muted); font-weight: 600; margin-top: 6rpx; }.wallet-action { font-size: 25rpx; color: var(--lm-muted); }.profile-links { padding: 12rpx 30rpx; }.profile-version { text-align: center; margin: 36rpx 0; }.logout { color: var(--lm-muted); font-size: 25rpx; margin: 24rpx auto; padding: 20rpx; }
.nickname-panel { margin-bottom: 30rpx; padding: 24rpx 30rpx; }
.theme-surface button.profile-name { display:block; width:100%; height:auto; min-height:0; padding:0; margin:0 0 8rpx; background:transparent; color:var(--lm-ink); border-radius:0; text-align:left; }
.profile-editor-mask { position:fixed; inset:0; background:rgba(40,31,23,.3); z-index:100; display:flex; align-items:flex-end; }
.profile-editor-sheet { width:100%; padding:36rpx 32rpx calc(24rpx + env(safe-area-inset-bottom)); background:var(--lm-paper); border-radius:32rpx 32rpx 0 0; }
.profile-editor-sheet .editor-cancel { width:100%; margin-top:20rpx; padding:16rpx; }
/* The button owns the frame; the image fills only its inner circle. */
.theme-surface .profile-top .profile-avatar-button { display:flex; align-items:center; justify-content:center; width:146rpx; height:146rpx; flex:0 0 146rpx; box-sizing:border-box; padding:6rpx; margin:0; border:5rpx double var(--lm-gold); border-radius:50%; overflow:hidden; background:var(--lm-soft); }
.theme-surface .profile-top .profile-avatar-button .profile-avatar { display:block; width:100%; height:100%; min-width:0; flex:1 1 auto; box-sizing:border-box; padding:0; border:0; border-radius:50%; overflow:hidden; background:var(--lm-soft); }
.theme-surface .profile-top .profile-avatar-button .user-avatar-fallback { display:flex; align-items:center; justify-content:center; font-size:52rpx; }
.account-avatar-actions { display:flex; align-items:center; flex-wrap:wrap; margin:18rpx 0; gap:14rpx; }.account-avatar-actions button { margin:0; width:auto; font-size:24rpx; }
