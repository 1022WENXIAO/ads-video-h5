<view class="theme-surface theme-{{theme}}">
<view class="screen"><view class="profile-top"><button size="mini" class="profile-avatar-button" open-type="chooseAvatar" bindchooseavatar="chooseAvatar" disabled="{{guest || savingAvatar || !canAvatar}}" aria-label="选择头像"><image wx:if="{{userAvatar}}" class="profile-avatar" src="{{userAvatar}}" mode="aspectFill" binderror="avatarError"/><view wx:else class="profile-avatar user-avatar-fallback">{{userInitial || '你'}}</view></button><view><view class="profile-name">{{guest ? '游客' : user.displayName || '微信创作者'}}</view><text class="muted">{{guest ? '可先浏览功能，自行选择登录' : user.authProvider === 'wechat' ? '微信账号' : '本地试用账号'}}</text></view></view><view class="stats"><view><text>{{films}}</text><text>成片</text></view><view><text>{{media}}</text><text>素材</text></view><view><text>{{sessions}}</text><text>会话</text></view></view>
  <view wx:if="{{guest}}" class="panel"><view class="muted">登录后可提交制作任务、管理个人素材与作品，并领取签到积分。</view><button size="mini" class="primary" bindtap="login"><image class="ui-icon" src="{{onPrimary.profile}}" mode="aspectFit"/>选择微信登录</button></view>
  <button size="mini" class="wallet-card" bindtap="navigate" data-page="credits"><view><view class="wallet-eyebrow">为灵感，添一点能量</view><text class="wallet-label">我的创作积分</text><text class="wallet-balance">{{balance}}</text><view class="wallet-caption">给每一个灵感，添一点能量</view></view><view class="wallet-action"><text>{{canCheckIn ? '签到领取 +' + dailyReward : '查看积分明细'}}</text><image class="ui-icon" src="{{onPrimary.send}}" mode="aspectFit"/></view></button>
  <view wx:if="{{!guest}}" class="panel account-avatar-panel"><view class="label">个人头像</view><view class="account-avatar-actions"><button size="mini" class="secondary" open-type="chooseAvatar" bindchooseavatar="chooseAvatar" disabled="{{savingAvatar || !canAvatar}}">选择微信头像</button><button size="mini" class="small-button" bindtap="customAvatar" disabled="{{savingAvatar || !canAvatar}}" loading="{{savingAvatar}}">上传自定义头像</button></view><view class="quiet">{{canAvatar ? '微信头像由你主动点选；自定义头像支持 4 MB 内的 PNG、JPEG、WebP。' : '当前连接的版本暂不支持保存头像。'}}</view></view>
  <view wx:if="{{!guest}}" class="panel nickname-panel"><view class="label">微信昵称（选填）</view><view class="row"><input class="input grow" type="nickname" value="{{nickname}}" bindinput="nickname" bindblur="nickname" placeholder="填写或选择微信昵称" maxlength="40" /><button size="mini" class="small-button" loading="{{savingName}}" disabled="{{savingName}}" bindtap="saveName">保存</button></view></view>
  <view class="panel profile-links"><button size="mini" class="link-row" bindtap="navigate" data-page="settings"><image class="ui-icon" src="{{icons.settings}}" mode="aspectFit"/><text>设置</text><text class="arrow">›</text></button></view><view class="quiet profile-version">轻喵LightMao · {{version}}<view>微信账号独立保存作品与积分。</view></view><button size="mini" wx:if="{{!guest}}" class="logout" loading="{{loggingOut}}" disabled="{{loggingOut}}" bindtap="logout">退出登录</button>
</view><privacy-dialog id="privacy" />
</view>
