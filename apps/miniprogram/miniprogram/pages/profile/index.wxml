<view class="theme-surface theme-{{theme}}">
<view wx:if="{{restoring || loadingState}}" class="startup-status">{{stateSyncError ? '暂未同步，显示上次内容' : restoring ? '已显示上次内容，正在同步…' : '正在加载…'}}</view>
<view class="screen"><view class="profile-top"><button size="mini" class="profile-avatar-button" bindtap="editAvatar" disabled="{{savingAvatar}}" aria-label="点击修改头像"><image wx:if="{{userAvatar}}" class="profile-avatar" src="{{userAvatar}}" mode="aspectFill" binderror="avatarError"/><view wx:else class="profile-avatar user-avatar-fallback">{{userInitial || '你'}}</view></button><view><button size="mini" class="profile-name" bindtap="editName" disabled="{{savingName}}" aria-label="点击修改昵称">{{guest ? '游客' : user.displayName || '微信创作者'}}</button><text class="muted">{{guest ? '可先浏览功能，自行选择登录' : '点击头像或名字修改'}}</text></view></view><view class="stats"><view><text>{{films}}</text><text>成片</text></view><view><text>{{media}}</text><text>素材</text></view><view><text>{{sessions}}</text><text>会话</text></view></view>
  <view wx:if="{{guest}}" class="panel"><view class="muted">登录后可提交制作任务、管理个人素材与作品，并领取签到积分。</view><button size="mini" class="primary" bindtap="login"><image class="ui-icon" src="{{onPrimary.profile}}" mode="aspectFit"/>选择微信登录</button></view>
  <button size="mini" class="wallet-card" bindtap="navigate" data-page="credits"><view><view class="wallet-eyebrow">为灵感，添一点能量</view><text class="wallet-label">我的创作积分</text><text class="wallet-balance">{{balance}}</text><view class="wallet-caption">给每一个灵感，添一点能量</view></view><view class="wallet-action"><text>{{canCheckIn ? '签到领取 +' + dailyReward : '查看积分明细'}}</text><image class="ui-icon" src="{{onPrimary.send}}" mode="aspectFit"/></view></button>
  <view class="panel profile-links"><button size="mini" class="link-row" bindtap="navigate" data-page="settings"><image class="ui-icon" src="{{icons.settings}}" mode="aspectFit"/><text>设置</text><text class="arrow">›</text></button></view><view class="quiet profile-version">轻喵LightMao · {{version}}<view>微信账号独立保存作品与积分。</view></view><button size="mini" wx:if="{{!guest}}" class="logout" loading="{{loggingOut}}" disabled="{{loggingOut}}" bindtap="logout">退出登录</button>
</view>
<view wx:if="{{avatarEditor || nameEditor}}" class="profile-editor-mask" bindtap="closeEditors"><view class="profile-editor-sheet" catchtap="noop">
  <view wx:if="{{avatarEditor}}"><view class="title">修改头像</view><button class="link-row" open-type="chooseAvatar" bindchooseavatar="chooseAvatar">选择微信头像</button><button class="link-row" bindtap="customAvatar">上传自定义头像</button><view class="quiet">支持 4 MB 内的 PNG、JPEG、WebP。</view></view>
  <view wx:if="{{nameEditor}}"><view class="title">修改昵称</view><input class="input" type="nickname" value="{{nickname}}" bindinput="nickname" bindblur="nickname" bindconfirm="saveName" focus="{{nameEditor}}" placeholder="填写或选择微信昵称" maxlength="40"/><button class="primary" loading="{{savingName}}" disabled="{{savingName}}" bindtap="saveName">保存</button></view>
  <button class="small-button editor-cancel" bindtap="closeEditors" disabled="{{savingName || savingAvatar}}">取消</button>
</view></view><privacy-dialog id="privacy" />
</view>
