<view class="theme-surface theme-{{theme}}">
<view class="screen"><view class="page-heading"><text>我的作品<text class="count">{{count}}</text></text><button size="mini" class="small-button" bindtap="create"><image class="ui-icon" src="{{onPrimary.create}}" mode="aspectFit"/>创作</button></view><view class="subtitle">从灵感到成片，你的每一次创作都在这里。</view><view wx:for="{{jobs}}" wx:key="id" class="panel running-card" bindtap="session" data-id="{{item.id}}"><view class="row spread"><text class="title">✦ {{item.label}}</text><text class="tag">{{item.progress}}%</text></view><view class="muted">{{item.stage}}</view><progress percent="{{item.progress}}" stroke-width="3" activeColor="{{progressColor}}" backgroundColor="{{progressTrack}}" /><text class="quiet">查看制作过程 →</text></view>
  <view class="filters"><button size="mini" class="{{filter === 'all' ? 'selected' : ''}}" data-kind="all" bindtap="filter">全部</button><button size="mini" class="{{filter === 'video' ? 'selected' : ''}}" data-kind="video" bindtap="filter">视频</button><button size="mini" class="{{filter === 'image' ? 'selected' : ''}}" data-kind="image" bindtap="filter">图片</button><button size="mini" class="{{filter === 'audio' ? 'selected' : ''}}" data-kind="audio" bindtap="filter">音频</button></view><view wx:if="{{!items.length}}" class="empty"><image class="empty-mark empty-icon" src="{{icons.films}}" mode="aspectFit"/><text class="title">第一支作品，等你开启</text><view class="muted">制作完成后，会自动同步到这里。<view>离开页面也不会中断已经提交的制作任务。</view></view><button size="mini" class="secondary" bindtap="create"><image class="ui-icon" src="{{onPrimary.create}}" mode="aspectFit"/>去创作</button></view>
  <view class="card-grid"><view wx:for="{{items}}" wx:key="id" class="media-tile" bindtap="play" data-id="{{item.id}}"><image wx:if="{{item.cover}}" class="media-cover" src="{{item.cover}}" mode="aspectFill" lazy-load data-id="{{item.id}}" binderror="coverError" /><view wx:else class="media-cover media-placeholder"><view class="placeholder-sun"/><view class="placeholder-hill"/><image class="placeholder-icon" src="{{item.kind === 'video' ? placeholderIcons.films : item.kind === 'audio' ? placeholderIcons.voice : placeholderIcons.library}}" mode="aspectFit"/><text>{{item.kind === 'video' ? '视频' : item.kind === 'audio' ? '音频' : '图片'}}</text></view><button size="mini" wx:if="{{item.coverError}}" class="small-button" catchtap="retryCover">重试缩略图</button><view class="media-info"><text class="media-name">{{item.name}}</text><view class="row spread"><text class="muted">{{item.duration || 'v' + item.version}}</text><text class="tag">{{item.status}}</text></view><text class="date">{{item.date}}</text></view></view></view><button size="mini" wx:if="{{more}}" class="secondary load-more" bindtap="more">加载更多</button>
</view><privacy-dialog id="privacy" />
</view>
