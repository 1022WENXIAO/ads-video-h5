<view class="theme-surface theme-{{theme}}"><view class="screen about-screen"><block wx:if="{{!selected}}"><view class="about-brand"><view class="cat-medallion"><image src="/assets/lightmao-logo.png" mode="aspectFit" aria-label="轻喵LightMao"/></view><view class="about-name">轻喵 LightMao</view><view class="muted">当前版本 {{version}}</view><view class="subtitle">好视频，从一句话开始。</view></view><view class="section-title">版本功能介绍</view><view class="panel"><button size="mini" class="link-row release-link" wx:for="{{releases}}" wx:key="version" bindtap="details" data-version="{{item.version}}"><view class="grow"><view class="title">{{item.version}} 主要更新<text wx:if="{{item.version === version}}" class="tag">当前版本</text></view><view class="muted">{{item.title}}</view><view class="date">{{item.date}}</view></view><text class="arrow">›</text></button></view></block><block wx:else><view class="page-heading"><text>轻喵 {{selected.version}}</text></view><view class="subtitle">{{selected.title}}</view><view class="date">{{selected.date}}</view><view class="panel release-features"><view class="release-feature" wx:for="{{selected.features}}" wx:key="*this"><image class="ui-icon" src="{{icons.checkIn}}" mode="aspectFit"/><text>{{item}}</text></view></view></block></view></view>
