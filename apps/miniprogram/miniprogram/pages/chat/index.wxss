.chat-screen { height: 100vh; display: flex; flex-direction: column; }.chat-header { padding: 24rpx 30rpx 18rpx; display: flex; align-items: center; justify-content: space-between; border-bottom: 1rpx solid #f4eee8; }.chat-header .brand { font-size: 44rpx; }.chat-header .row { gap: 4rpx; }.chat-header .small-button { font-size: 22rpx; }.thread { flex: 1; height: 0; }.thread-inner { padding: 30rpx; }.welcome { padding: 58rpx 4rpx 30rpx; }.welcome-mark { color: #ed815f; font-size: 72rpx; }.welcome-title { margin: 14rpx 0; font-size: 36rpx; font-weight: 650; }.suggestions { margin-top: 44rpx; }.suggestions button { width: 100%; text-align: left; padding: 25rpx 24rpx; margin: 18rpx 0; border: 1rpx solid #ede4db; border-radius: 22rpx; font-size: 25rpx; display: flex; justify-content: space-between; }.suggestions text { color: #d69777; }.message { margin-bottom: 34rpx; }.message-role { margin-bottom: 14rpx; font-size: 24rpx; color: #aa7357; }.message.user .message-role { text-align: right; }.message-bubble { padding: 25rpx 26rpx; line-height: 1.8; border-radius: 26rpx; background: #fff; border: 1rpx solid #eee5dc; white-space: pre-wrap; overflow-wrap: break-word; }.user .message-bubble { background: #fae9df; border-color: #fae9df; }.process-toggle { color: #9c8d7e; font-size: 23rpx; margin: 18rpx 0; text-align: left; }.commentary { border-left: 3rpx solid #edd3bd; padding-left: 20rpx; color: #87796c; font-size: 24rpx; line-height: 1.8; white-space: pre-wrap; }.commentary view { margin-bottom: 18rpx; }.job { margin-top: 18rpx; margin-bottom: 0; padding: 26rpx; }.job .title { font-size: 26rpx; }.job progress { margin: 18rpx 0; }.tool-list { margin-top: 20rpx; }.tool-list > view { border-top: 1rpx solid #f1e9e0; padding: 16rpx 0; }.tool-name { display: block; color: #8c7766; font-size: 23rpx; }.tool-detail { display: block; white-space: pre-wrap; max-height: 300rpx; overflow: auto; }.artifact-link { display: flex; flex-direction: column; gap: 10rpx; background: #f8f1e6; padding: 24rpx; margin-top: 18rpx; text-align: left; width: 100%; }.user .date { text-align: right; }.thread-end { height: 8rpx; }.older { margin: 0 auto 25rpx; }.composer-wrap { padding: 14rpx 22rpx 10rpx; background: #fffdf9; border-top: 1rpx solid #f0e9e2; }.composer-wrap > .error { margin: 4rpx 12rpx 15rpx; font-size: 22rpx; }.composer { border: 1rpx solid #e8ded4; border-radius: 30rpx; padding: 24rpx; background: #fff; }.composer textarea { min-height: 70rpx; max-height: 220rpx; width: 100%; font-size: 28rpx; line-height: 1.6; }.composer-actions { display: flex; justify-content: space-between; align-items: center; margin-top: 18rpx; }.composer-actions .row { gap: 12rpx; }.icon-button { font-size: 40rpx; width: 52rpx; color: #716758; }.newline { color: #8d7e6d; font-size: 22rpx; }.send-button { background: #ed815f; color: #fff; width: 70rpx; height: 70rpx; border-radius: 50%; font-size: 40rpx; line-height: 70rpx; }.voice-button { border-radius: 50%; background: #f7f2ec; width: 78rpx; height: 74rpx; font-size: 27rpx; line-height: 38rpx; }.voice-button text { display: block; font-size: 16rpx; line-height: 20rpx; color: #96887a; }.stop-button { color: #b87552; font-size: 20rpx; }.composer-note { text-align: center; font-size: 18rpx; margin-top: 9rpx; }.voice-status { text-align: center; color: #9a7a5e; font-size: 23rpx; padding: 12rpx; }.voice-status.live { color: #dc765b; }.credit-warning { color: #b7793d; font-size: 24rpx; padding: 8rpx 12rpx 16rpx; }.attachments { white-space: nowrap; margin-bottom: 14rpx; }.attachment { display: inline-flex; align-items: center; gap: 10rpx; max-width: 300rpx; padding: 6rpx 18rpx; background: #f6eddf; border-radius: 18rpx; margin-right: 12rpx; font-size: 22rpx; }.attachment text { overflow: hidden; text-overflow: ellipsis; }.attachment button { padding: 0 4rpx; color: #a5907e; }.picker-mask { position: fixed; inset: 0; background: rgba(40,31,23,.25); z-index: 30; display: flex; align-items: flex-end; }.picker-sheet { width: 100%; padding: 35rpx 32rpx calc(40rpx + env(safe-area-inset-bottom)); background: #fffdf9; border-radius: 36rpx 36rpx 0 0; }.source-list { height: 50vh; margin: 25rpx 0; }.source-row { display: flex; justify-content: space-between; align-items: center; gap: 20rpx; padding: 22rpx; border-bottom: 1rpx solid #eee5da; border-radius: 12rpx; text-align: left; font-size: 25rpx; }.source-row > text:first-child { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }.source-row.selected { background: #faeadd; }

.mic-mark { width: 32rpx; height: 34rpx; position: relative; margin: 6rpx auto 2rpx; }.mic-capsule { position: absolute; left: 10rpx; top: 0; width: 13rpx; height: 22rpx; border: 3rpx solid #82796e; border-radius: 12rpx; }.mic-arc { position: absolute; left: 4rpx; top: 12rpx; width: 25rpx; height: 17rpx; border: 3rpx solid #82796e; border-top: 0; border-radius: 0 0 15rpx 15rpx; }.mic-stand { position: absolute; left: 15rpx; top: 27rpx; width: 3rpx; height: 7rpx; background: #82796e; }.voice-button .record-dot { color: #df7559; font-size: 28rpx; line-height: 38rpx; }

.chat-header-actions { gap: 4rpx; }
.chat-header-actions .small-button { padding-inline: 12rpx; white-space: nowrap; }
.chat-header-actions .gallery-entry { color: #8e4b35; background: #fbefe4; }
.composer-template-chip { display: inline-flex; align-items: center; gap: 12rpx; color: #8e4b35; background: #fbefe4; border-radius: 10rpx; padding: 2rpx 12rpx; font-size: 20rpx; margin: 8rpx 0; }
.composer-template-chip button { color: #8e4b35; font-size: 27rpx; line-height: 1; padding: 5rpx; }
