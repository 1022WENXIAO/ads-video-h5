.chat-screen { width: 100%; min-width: 0; height: 100vh; overflow: hidden; display: flex; flex-direction: column; }.chat-header { padding: 24rpx 30rpx 18rpx; display: flex; align-items: center; justify-content: space-between; border-bottom: 1rpx solid var(--lm-line); }.chat-header .brand { font-size: 44rpx; }.chat-header .row { gap: 4rpx; }.chat-header .small-button { width: auto; min-width: 0; flex: 0 0 auto; margin: 0; padding: 8rpx 12rpx; font-size: 22rpx; white-space: nowrap; }.thread { flex: 1; min-height: 0; width: 100%; height: 0; }.thread-inner { padding: 30rpx; }.welcome { padding: 58rpx 4rpx 30rpx; }.welcome-mark { color: var(--lm-accent); font-size: 72rpx; }.welcome-title { margin: 14rpx 0; font-size: 36rpx; font-weight: 600; }.suggestions { margin-top: 44rpx; }.suggestions button { width: 100%; text-align: left; padding: 25rpx 24rpx; margin: 18rpx 0; border: 1rpx solid var(--lm-line); border-radius: 22rpx; font-size: 25rpx; display: flex; justify-content: space-between; }.suggestions text { color: var(--lm-accent); }.message { margin-bottom: 34rpx; }.message-role { margin-bottom: 14rpx; font-size: 24rpx; color: var(--lm-accent); }.message.user .message-role { text-align: right; }.message-bubble { padding: 25rpx 26rpx; line-height: 1.8; border-radius: 26rpx; background: var(--lm-paper); border: 1rpx solid var(--lm-line); white-space: pre-wrap; overflow-wrap: break-word; }.user .message-bubble { background: var(--lm-soft); border-color: var(--lm-line); }.process-toggle { color: var(--lm-muted); font-size: 23rpx; margin: 18rpx 0; text-align: left; }.commentary { border-left: 3rpx solid var(--lm-line); padding-left: 20rpx; color: var(--lm-muted); font-size: 24rpx; line-height: 1.8; white-space: pre-wrap; }.commentary view { margin-bottom: 18rpx; }.job { margin-top: 18rpx; margin-bottom: 0; padding: 26rpx; }.job .title { font-size: 26rpx; }.job progress { margin: 18rpx 0; }.tool-list { margin-top: 20rpx; }.tool-list > view { border-top: 1rpx solid var(--lm-line); padding: 16rpx 0; }.tool-name { display: block; color: var(--lm-muted); font-size: 23rpx; }.tool-detail { display: block; white-space: pre-wrap; max-height: 300rpx; overflow: auto; }.artifact-link { display: flex; flex-direction: column; gap: 10rpx; background: var(--lm-soft); padding: 24rpx; margin-top: 18rpx; text-align: left; width: 100%; }.user .date { text-align: right; }.thread-end { height: 8rpx; }.older { margin: 0 auto 25rpx; }.composer-wrap { padding: 14rpx 22rpx 10rpx; background: var(--lm-paper); border-top: 1rpx solid var(--lm-line); }.composer-wrap > .error { margin: 4rpx 12rpx 15rpx; font-size: 22rpx; }.composer { border: 1rpx solid var(--lm-line); border-radius: 30rpx; padding: 24rpx; background: var(--lm-paper); }.composer textarea { min-height: 70rpx; max-height: 220rpx; width: 100%; font-size: 28rpx; line-height: 1.6; }.composer-actions { display: flex; justify-content: space-between; align-items: center; margin-top: 18rpx; }.composer-actions .row { width: auto; min-width: 0; flex: 0 0 auto; gap: 12rpx; }.icon-button { font-size: 40rpx; width: 52rpx; color: var(--lm-muted); }.newline { width: 100rpx; color: var(--lm-muted); font-size: 22rpx; }.send-button { background: var(--lm-accent); color: var(--lm-paper); width: 70rpx; height: 70rpx; border-radius: 50%; font-size: 40rpx; line-height: 70rpx; }.voice-button { border-radius: 50%; background: var(--lm-soft); width: 78rpx; height: 74rpx; font-size: 27rpx; line-height: 38rpx; }.voice-button text { display: block; font-size: 16rpx; line-height: 20rpx; color: var(--lm-muted); }.stop-button { width: 88rpx; color: var(--lm-accent); font-size: 20rpx; }.composer-note { text-align: center; font-size: 18rpx; margin-top: 9rpx; }.voice-status { text-align: center; color: var(--lm-muted); font-size: 23rpx; padding: 12rpx; }.voice-status.live { color: var(--lm-accent); }.credit-warning { color: var(--lm-accent); font-size: 24rpx; padding: 8rpx 12rpx 16rpx; }.attachments { white-space: nowrap; margin-bottom: 14rpx; }.attachment { display: inline-flex; align-items: center; gap: 10rpx; max-width: 300rpx; padding: 6rpx 18rpx; background: var(--lm-soft); border-radius: 18rpx; margin-right: 12rpx; font-size: 22rpx; }.attachment text { overflow: hidden; text-overflow: ellipsis; }.attachment button { padding: 0 4rpx; color: var(--lm-muted); }.picker-mask { position: fixed; inset: 0; background: rgba(40,31,23,.25); z-index: 30; display: flex; align-items: flex-end; }.picker-sheet { width: 100%; padding: 35rpx 32rpx calc(40rpx + env(safe-area-inset-bottom)); background: var(--lm-paper); border-radius: 36rpx 36rpx 0 0; }.source-list { height: 50vh; margin: 25rpx 0; }.source-row { display: flex; justify-content: space-between; align-items: center; gap: 20rpx; padding: 22rpx; border-bottom: 1rpx solid var(--lm-line); border-radius: 12rpx; text-align: left; font-size: 25rpx; }.source-row > text:first-child { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }.source-row.selected { background: var(--lm-soft); }

.mic-mark { width: 32rpx; height: 34rpx; position: relative; margin: 6rpx auto 2rpx; }.mic-capsule { position: absolute; left: 10rpx; top: 0; width: 13rpx; height: 22rpx; border: 3rpx solid var(--lm-line); border-radius: 12rpx; }.mic-arc { position: absolute; left: 4rpx; top: 12rpx; width: 25rpx; height: 17rpx; border: 3rpx solid var(--lm-line); border-top: 0; border-radius: 0 0 15rpx 15rpx; }.mic-stand { position: absolute; left: 15rpx; top: 27rpx; width: 3rpx; height: 7rpx; background: var(--lm-muted); }.voice-button .record-dot { color: var(--lm-accent); font-size: 28rpx; line-height: 38rpx; }

/* Explicit toolbar sizes override native button sizing on Android and iOS. */
.composer-wrap, .chat-header { flex-shrink: 0; min-width: 0; }
.composer { min-width: 0; }
.composer-actions { width: 100%; min-width: 0; gap: 12rpx; }
.composer-actions button { flex: 0 0 auto; min-width: 0; margin: 0; padding: 0; white-space: nowrap; }
.composer-actions .newline, .composer-actions .stop-button { height: 70rpx; line-height: 70rpx; }
.composer-note { overflow-wrap: break-word; }

/* Keep explicit control dimensions above the native size=mini button rules. */
.composer-actions .icon-button { width: 52rpx; }
.composer-actions .newline { width: 100rpx; }
.composer-actions .stop-button { width: 88rpx; }
.composer-actions .voice-button { width: 78rpx; height: 74rpx; border-radius: 50%; }
.composer-actions .send-button { width: 70rpx; height: 70rpx; line-height: 70rpx; border-radius: 50%; }
.guest-note { font-size: 22rpx; line-height: 1.6; margin: 4rpx 12rpx 14rpx; }

/* Render consent in the page to avoid native component-template lifecycle issues. */
.voice-consent-mask { position: fixed; top: 0; right: 0; bottom: 0; left: 0; z-index: 900; background: rgba(40,32,24,.5); display: flex; align-items: center; justify-content: center; padding: 32rpx; }
.voice-consent-dialog { box-sizing: border-box; width: 100%; max-width: 680rpx; max-height: calc(100vh - 100rpx - env(safe-area-inset-bottom)); display: flex; flex-direction: column; background: var(--lm-paper); border-radius: 32rpx; padding: 32rpx; }
.voice-consent-heading { flex-shrink: 0; font-size: 34rpx; font-weight: 600; color: var(--lm-ink); }.voice-consent-intro { flex-shrink: 0; font-size: 25rpx; line-height: 1.7; color: var(--lm-muted); margin: 16rpx 0 22rpx; }
.voice-consent-terms { height: 48vh; min-height: 120rpx; flex-shrink: 1; overflow: hidden; background: var(--lm-soft); border-radius: 18rpx; }.voice-consent-version { padding: 20rpx 22rpx 0; font-size: 21rpx; color: var(--lm-muted); }.voice-consent-section { padding: 20rpx 22rpx 0; }.voice-consent-section:last-child { padding-bottom: 24rpx; }.voice-consent-title { color: var(--lm-ink); font-size: 25rpx; font-weight: 600; }.voice-consent-copy { color: var(--lm-muted); font-size: 24rpx; line-height: 1.8; margin-top: 10rpx; }
.voice-consent-hint { flex-shrink: 0; color: var(--lm-muted); font-size: 22rpx; line-height: 1.65; margin: 18rpx 0; }.voice-consent-actions { flex-shrink: 0; display: flex; gap: 16rpx; }.voice-consent-action { box-sizing: border-box; flex: 1; margin: 0; padding: 22rpx 8rpx; font-size: 24rpx; line-height: 1.5; border-radius: 16rpx; background: var(--lm-soft); color: var(--lm-muted); }.voice-consent-action::after { border: 0; }.voice-consent-agree { background: var(--lm-accent); color: var(--lm-paper); }
.source-thumb { width: 80rpx; height: 80rpx; flex: 0 0 80rpx; border-radius: 12rpx; margin-right: 16rpx; }
.source-name { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; text-align: left; }
.source-row { width: 100%; min-width: 0; margin: 0; flex-direction: row; }
.source-row .tag { flex: 0 0 auto; }
.source-list { display: block; width: 100%; }
.picker-sheet .source-row { display: flex; width: 100%; max-width: none; }

.brand-logo { width: 96rpx; height: 96rpx; flex: 0 0 96rpx; display: block; }

.workspace-bar { display:flex; flex-shrink:0; align-items:center; justify-content:space-between; padding:16rpx 30rpx; background:var(--lm-paper); }.mode-tabs { display:flex; padding:6rpx; border-radius:40rpx; background:var(--lm-soft); }.mode-tabs button { width:140rpx; padding:10rpx; margin:0; color:var(--lm-muted); font-size:26rpx; border-radius:32rpx; }.mode-tabs .active { background:var(--lm-accent); color:var(--lm-paper); }.tasks-entry { width:auto; margin:0; padding:10rpx; font-size:23rpx; color:var(--lm-muted); }.conversation-heading { padding:12rpx 32rpx 18rpx; flex-shrink:0; background:var(--lm-paper); }.conversation-heading > text:first-child { display:block; font-size:30rpx; font-weight:600; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }.conversation-heading .quiet { display:block; font-size:21rpx; margin-top:6rpx; }.chat-welcome { text-align:center; padding:45rpx 14rpx; }.chat-welcome > image { width:130rpx; height:130rpx; }.chat-welcome .muted { font-size:25rpx; line-height:1.8; }.chat-prompts { margin-top:40rpx; }.chat-prompts button { width:100%; margin:18rpx 0; padding:24rpx; background:var(--lm-soft); font-size:26rpx; text-align:left; border-radius:24rpx; color:var(--lm-ink); }.work-brief .muted { display:block; margin:16rpx 0; line-height:1.8; }.work-brief button { margin-top:14rpx; }

.thread-start { height: 1rpx; }

.composer-model { display:block; max-width:100%; margin:0 0 16rpx; }.model-trigger { display:inline-flex; align-items:center; max-width:100%; min-height:36rpx; font-size:24rpx; color:var(--lm-ink); }.model-name { overflow:hidden; white-space:nowrap; text-overflow:ellipsis; }.model-chevron { flex-shrink:0; color:var(--lm-muted); margin-left:12rpx; font-family:system-ui,sans-serif; font-size:27rpx; line-height:1; }

.message.assistant .message-role { display:flex; align-items:center; column-gap:14rpx; }.message-progress { font-size:20rpx; color:var(--lm-muted); font-family:system-ui,sans-serif; }.reply-details { margin-top:16rpx; border:1rpx solid var(--lm-line); border-radius:0 0 20rpx 20rpx; background:var(--lm-paper); overflow:hidden; }.reply-details .process-toggle { display:flex; align-items:center; justify-content:flex-start; width:100%; margin:0; padding:18rpx 24rpx; font-size:24rpx; color:var(--lm-ink); border-radius:0; text-align:left; background:var(--lm-soft); }.detail-chevron { margin-left:16rpx; line-height:1; font-family:system-ui,sans-serif; }.detail-chevron.expanded { transform:rotate(180deg); }.process-records { padding:20rpx 24rpx; }.process-step { padding:14rpx 0; border-top:1rpx solid var(--lm-line); }.reply-pending { color:var(--lm-muted); font-size:24rpx; line-height:1.7; padding:12rpx 0; }.reply-retry { width:auto; margin:16rpx 0; }.message-error { font-size:24rpx; }

/* Disclosure belongs to the reply; deliverables have their own spacing. */
.reply-details { margin-top:12rpx; border:0; border-radius:0; background:transparent; overflow:visible; }.reply-details .process-toggle { width:auto; max-width:100%; margin:0; padding:8rpx 0; background:transparent; font-size:23rpx; color:var(--lm-muted); }.reply-details .process-records { padding:16rpx 0; background:transparent; }.message-deliverables { margin-top:30rpx; }.message-deliverables .artifact-link { display:flex; flex-direction:column; align-items:flex-start; width:100%; min-width:0; margin:0 0 18rpx; padding:24rpx; text-align:left; white-space:normal; }.message-deliverables .artifact-link > text { display:block; max-width:100%; overflow-wrap:break-word; }.message-deliverables .artifact-link .quiet { margin-top:10rpx; }

.theme-surface .chat-brandbar { display:flex; align-items:center; min-height:112rpx; padding:12rpx 24rpx; gap:12rpx; }.theme-surface .chat-brandbar .brand-logo { width:50rpx; height:60rpx; flex:0 0 50rpx; }.brand-wordmark { min-width:0; font-size:30rpx; white-space:nowrap; }.brand-wordmark .brand-latin { display:block; font-size:16rpx; letter-spacing:1rpx; }.brand-mode-tabs { margin-left:auto; flex-shrink:0; background:rgba(255,245,225,.2); }.brand-mode-tabs button { width:88rpx; padding:10rpx 8rpx; font-size:23rpx; color:#fff0db; }.brand-mode-tabs .active { background:#fff0db; color:#a74c27; }.sidebar-toggle { width:56rpx; height:60rpx; flex:0 0 56rpx; margin:0; padding:14rpx; display:flex; align-items:center; justify-content:center; color:inherit; }.sidebar-glyph { width:30rpx; height:28rpx; border:2rpx solid currentColor; border-radius:5rpx; position:relative; box-sizing:border-box; }.sidebar-glyph::before { content:''; position:absolute; top:0; bottom:0; left:8rpx; border-left:2rpx solid currentColor; }.chat-brandbar .sidebar-toggle { color:#fff0db; }
.message-role { display:flex; align-items:center; gap:14rpx; min-height:48rpx; }.message.user .message-role { justify-content:flex-end; }.message-avatar { display:block; width:48rpx; height:48rpx; flex:0 0 48rpx; border-radius:50%; }.user-avatar-fallback { display:flex; align-items:center; justify-content:center; border-radius:50%; background:var(--lm-soft); color:var(--lm-accent); font-size:23rpx; }.assistant-avatar { border:1rpx solid var(--lm-line); }
.sidebar-layer { position:fixed; inset:0; z-index:70; }.sidebar-backdrop { position:absolute; inset:0; background:rgba(40,30,20,.35); }.sidebar-drawer { position:absolute; left:0; top:0; bottom:0; width:610rpx; max-width:86vw; background:var(--lm-paper); display:flex; flex-direction:column; box-shadow:12rpx 0 40rpx rgba(40,30,20,.12); }.sidebar-heading { padding:24rpx; display:flex; align-items:center; justify-content:space-between; flex-shrink:0; }.sidebar-brand { display:flex; align-items:center; gap:16rpx; font-size:30rpx; font-weight:600; }.sidebar-brand image { width:60rpx; height:60rpx; border-radius:50%; }.sidebar-menu { padding:0 22rpx 16rpx; border-bottom:1rpx solid var(--lm-line); flex-shrink:0; }.sidebar-menu button { display:flex; align-items:center; gap:18rpx; width:100%; margin:0; padding:16rpx 12rpx; font-size:27rpx; text-align:left; }.sidebar-search { flex-shrink:0; height:68rpx; min-height:68rpx; border:1rpx solid var(--lm-line); background:var(--lm-paper); border-radius:16rpx; margin:20rpx 24rpx 12rpx; padding:0 20rpx; font-size:24rpx; }.sidebar-filters { flex-shrink:0; display:flex; padding:0 24rpx 12rpx; }.sidebar-filters button { width:auto; margin:0 8rpx 0 0; padding:8rpx 16rpx; font-size:22rpx; color:var(--lm-muted); border-radius:18rpx; }.sidebar-filters .chosen { background:var(--lm-soft); color:var(--lm-accent); }.sidebar-history { flex:1; min-height:0; height:0; width:100%; }.sidebar-group { padding:0 16rpx 22rpx; }.sidebar-group-title { padding:20rpx 16rpx 12rpx; color:var(--lm-muted); font-size:22rpx; }.sidebar-session { display:flex; align-items:center; min-height:74rpx; padding:10rpx 14rpx; border-radius:18rpx; }.sidebar-session.selected { background:var(--lm-soft); }.sidebar-session-icon { width:28rpx; height:28rpx; flex:0 0 28rpx; margin-right:14rpx; }.sidebar-session-title { flex:1; min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; font-size:25rpx; }.sidebar-session-more { width:48rpx; flex:0 0 48rpx; height:44rpx; padding:0; margin:0 0 0 8rpx; line-height:38rpx; font-size:30rpx; color:var(--lm-muted); }.sidebar-empty { padding:40rpx 30rpx; color:var(--lm-muted); font-size:25rpx; }.sidebar-load-more { width:auto; font-size:24rpx; color:var(--lm-muted); margin:12rpx auto 24rpx; }.sidebar-account { flex-shrink:0; width:100%; margin:0; padding:20rpx 26rpx calc(20rpx + env(safe-area-inset-bottom)); display:flex; align-items:center; gap:16rpx; border-top:1rpx solid var(--lm-line); text-align:left; font-size:25rpx; }.sidebar-account image,.sidebar-account .user-avatar-fallback { width:52rpx; height:52rpx; flex:0 0 52rpx; border-radius:50%; }.sidebar-account > text { overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }.sidebar-account-arrow { margin-left:auto; }

/* Give every header control one center line and a complete raster outline. */
.theme-surface .chat-brandbar { min-height:104rpx; padding:12rpx 24rpx; align-items:center; gap:14rpx; }.theme-surface .chat-brandbar .sidebar-toggle,.sidebar-heading .sidebar-toggle { display:flex; width:64rpx; height:64rpx; min-height:64rpx; flex:0 0 64rpx; padding:14rpx; margin:0; align-items:center; justify-content:center; box-sizing:border-box; }.sidebar-glyph-image { display:block; width:36rpx; height:36rpx; flex:0 0 36rpx; }.theme-surface .chat-brandbar .brand-logo { display:block; width:52rpx; height:64rpx; flex:0 0 52rpx; }.brand-wordmark { display:flex; flex-direction:column; justify-content:center; height:64rpx; min-width:0; line-height:1.15; gap:4rpx; }.brand-wordmark .brand-latin { line-height:1.15; }.brand-mode-tabs { display:flex; align-items:center; min-height:64rpx; box-sizing:border-box; }.brand-mode-tabs button { display:flex; align-items:center; justify-content:center; height:56rpx; line-height:56rpx; padding:0 8rpx; margin:0; }
