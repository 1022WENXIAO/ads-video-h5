<view class="theme-surface chat-surface theme-{{theme}}">
<view class="chat-screen {{keyboardHeight ? 'keyboard-open' : ''}}" style="{{viewportHeight ? 'height:' + viewportHeight + 'px;' : ''}}">
  <view class="chat-brandbar"><button size="mini" class="sidebar-toggle" bindtap="openSidebar" aria-label="展开侧边栏"><image class="sidebar-glyph-image" src="/assets/ui/sidebar-light.png" mode="aspectFit"/></button><image class="brand-logo" src="/assets/lightmao-logo.png" mode="aspectFit"/><view class="brand-wordmark">轻喵<text class="brand-latin">LightMao</text></view><view class="mode-tabs brand-mode-tabs"><button size="mini" class="{{mode === 'chat' ? 'active' : ''}}" bindtap="switchMode" data-mode="chat">对话</button><button size="mini" class="{{mode === 'work' ? 'active' : ''}}" bindtap="switchMode" data-mode="work">工作</button></view></view>
  <view wx:if="{{!empty}}" class="conversation-heading"><text>{{title}}</text><text class="quiet">{{mode === 'chat' ? '自在聊聊' : '轻喵创作工坊'}}</text></view>
  <scroll-view class="thread" scroll-y scroll-into-view="{{scrollTarget}}" scroll-with-animation="{{!keyboardHeight && !empty}}">
    <view class="thread-inner"><view id="thread-start" class="thread-start" />
      <view wx:if="{{empty && mode === 'work'}}" class="welcome"><view class="suggestions"><button size="mini" bindtap="suggestion" data-text="制作一段 30 秒的人工智能新闻口播视频，先搜索并核验近期事件。"><view class="suggest-icon"><image src="/assets/ui/fresh/active/news.png" mode="aspectFit"/></view><view class="suggest-copy">今天 AI 圈发生了什么？<text class="suggest-detail">新闻口播 · 30 秒</text></view><text class="suggest-arrow">↗</text></button><button size="mini" bindtap="suggestion" data-text="制作一个 45 秒的科普视频，用日常例子解释什么是大模型。"><view class="suggest-icon"><image src="/assets/ui/fresh/active/idea.png" mode="aspectFit"/></view><view class="suggest-copy">把一个知识点讲明白<text class="suggest-detail">知识科普 · 45 秒</text></view><text class="suggest-arrow">↗</text></button><button size="mini" bindtap="suggestion" data-text="把我选择的素材剪成 20 秒短片，节奏轻快，配字幕和音乐。"><view class="suggest-icon"><image src="/assets/ui/fresh/active/films.png" mode="aspectFit"/></view><view class="suggest-copy">把素材剪成故事<text class="suggest-detail">素材剪辑 · 20 秒</text></view><text class="suggest-arrow">↗</text></button></view><view class="welcome-hero"><view class="cat-medallion"><image src="/assets/lightmao-logo.png" mode="aspectFit" aria-label="轻喵LightMao"/></view><view class="welcome-eyebrow">{{theme === 'rich' ? '每一份灵感，都值得上映' : '灵感有光，故事有你'}}</view><view class="welcome-title">{{theme === 'rich' ? '好视频，\n从一句话开始。' : '给灵感一点橙光\n让故事轻轻发生'}}</view><view class="subtitle">说出主题、风格和时长，<view>轻喵为你开始制作。</view></view></view></view>
      <view wx:if="{{empty && mode === 'chat'}}" class="chat-welcome"><image src="/assets/lightmao-logo.png" mode="aspectFit"/><view class="welcome-eyebrow">灵感，也从闲聊开始</view><view class="welcome-title">今天，想聊点什么？</view><view class="muted">分享日常、探索问题，或慢慢想清楚一个念头。</view><view class="chat-prompts"><button size="mini" bindtap="suggestion" data-text="我最近有个模糊的想法，陪我一起想想。">陪我理理思路 ↗</button><button size="mini" bindtap="suggestion" data-text="我想学习一个新知识，先聊聊我感兴趣的方向。">一起探索新知识 ↗</button></view></view>
      <view wx:if="{{empty && mode === 'work'}}" class="work-brief panel"><view class="title">还没有想好做什么，也没关系</view><text class="muted">从想解决的问题开始，一起明确目标、受众、产出和素材。</text><button size="mini" class="secondary" bindtap="suggestion" data-text="我想做点内容，但还没想好具体形式。请先陪我梳理目标、受众和最后想交付什么。">帮我梳理工作需求 ↗</button><button size="mini" class="small-button" bindtap="suggestion" data-text="我需要写一份工作简报，请先问我目标、给谁看、现有材料和截止时间，再一起确定结构。">工作简报</button><button size="mini" class="small-button" bindtap="suggestion" data-text="我想把一个主题做成视频，请先帮我明确主题、受众、时长、风格和现有素材，再整理创作需求。">视频策划</button></view>
      <button size="mini" wx:if="{{hasOlder}}" class="small-button older" bindtap="older">查看更早的消息</button>
      <button size="mini" wx:if="{{hasNewer}}" class="small-button older" bindtap="latest">返回最新消息 ↓</button>
      <view wx:for="{{messages}}" wx:key="id" class="message {{item.role}}">
        <view class="message-role"><block wx:if="{{item.role === 'assistant'}}"><image class="message-avatar assistant-avatar" src="/assets/lightmao-assistant.jpg" mode="aspectFill"/><text>轻喵LightMao</text><text wx:if="{{item.job}}" class="message-progress">{{item.job.progress}}%</text></block><block wx:else><text>{{userDisplayName || '你'}}</text><image wx:if="{{userAvatar}}" class="message-avatar" src="{{userAvatar}}" mode="aspectFill" binderror="avatarError"/><view wx:else class="message-avatar user-avatar-fallback">{{userInitial || '你'}}</view></block></view>
        <view wx:if="{{item.text}}" class="message-bubble"><text selectable>{{item.text}}</text></view>
        <view wx:if="{{item.role === 'assistant' && item.job.active && !item.text}}" class="reply-pending">{{item.job.stage || '正在回复…'}}</view>
        <view wx:if="{{item.role === 'assistant' && (item.recordCount || item.partCount || item.long)}}" class="reply-details">
          <button size="mini" class="process-toggle" bindtap="expand" data-id="{{item.id}}"><text>{{item.open ? '收起' : (item.recordCount || item.partCount) ? '查看 ' + (item.recordCount || item.partCount) + ' 条处理记录' : '展开全文'}}</text><text class="detail-chevron {{item.open ? 'expanded' : ''}}">⌄</text></button>
          <view wx:if="{{item.open}}" class="process-records"><view wx:if="{{item.parts.length}}" class="commentary"><view wx:for="{{item.parts}}" wx:for-item="part" wx:key="id"><text selectable>{{part.text}}</text></view></view><view wx:for="{{item.job.workflow}}" wx:for-item="step" wx:key="id" class="process-step"><text class="tool-name">{{step.stage || step.tool}} · {{step.status}}{{step.seconds ? ' · ' + step.seconds + '秒' : ''}}</text><text class="muted tool-detail" selectable>{{step.detail}}</text></view></view>
        </view>
        <view wx:if="{{item.role === 'assistant' && item.job.error}}" class="error message-error">{{item.job.error}}</view>
        <button size="mini" wx:if="{{item.role === 'assistant' && item.job.failed}}" class="secondary reply-retry" bindtap="retry" data-id="{{item.job.id}}"><image class="ui-icon" src="{{icons.retry}}" mode="aspectFit"/>重试</button>
        <text class="date">{{item.date}}</text>
        <view wx:if="{{item.artifacts.length}}" class="message-deliverables">
        <button size="mini" wx:for="{{item.artifacts}}" wx:for-item="work" wx:key="id" class="artifact-link" bindtap="play" data-id="{{work.id}}"><text>▷ {{work.name}}</text><text class="quiet">{{work.duration}} · {{work.status}}</text></button>
        </view>
      </view><view id="thread-end" class="thread-end" />
    </view>
  </scroll-view>
  <view class="composer-wrap">
    <view wx:if="{{guest}}" class="guest-note quiet">可先浏览、试填制作需求；提交制作或添加素材时再选择微信登录。</view>
    <view wx:if="{{error}}" class="error">{{error}}</view><view wx:if="{{insufficient && !voiceReady}}" class="credit-warning" bindtap="credits">积分不足，去签到领取 →</view>
    <view wx:if="{{uploading}}" class="quiet">{{uploadText}}</view><view wx:if="{{voice !== 'idle'}}" class="voice-status {{voice === 'recording' ? 'live' : ''}}">{{voiceLabel}}</view>
    <scroll-view wx:if="{{attached.length}}" class="attachments" scroll-x><view wx:for="{{attached}}" wx:key="id" class="attachment"><text>{{item.name}}</text><button size="mini" bindtap="removeAttachment" data-id="{{item.id}}">×</button></view></scroll-view>
    <view class="composer"><picker class="composer-model" mode="selector" range="{{models}}" range-key="name" value="{{modelIndex}}" bindchange="changeModel" disabled="{{modelChanging || running || sending || creatingSession || uploading || voice !== 'idle' || !models.length}}" aria-label="选择对话模型"><view class="model-trigger"><text class="model-name">{{modelChanging ? '切换中…' : modelName}}</text><text class="model-chevron">⌄</text></view></picker><textarea value="{{prompt}}" bindinput="input" bindblur="blur" placeholder="{{mode === 'chat' ? '和轻喵聊聊…' : '你想实现什么？一起想清楚…'}}" maxlength="2000" adjust-position="{{false}}" bindfocus="focusEditor" bindkeyboardheightchange="keyboardChange" auto-height confirm-type="return" show-confirm-bar="{{false}}" cursor-spacing="0" cursor="{{editorCursor}}" focus="{{focus}}" disabled="{{modelChanging || sending || creatingSession || uploading || voice !== 'idle'}}" />
      <view class="composer-actions"><view class="row"><button size="mini" class="icon-button" bindtap="pick" disabled="{{uploading || sending || voice !== 'idle'}}"><image class="ui-icon" src="{{icons.add}}" mode="aspectFit"/></button><button size="mini" class="newline" bindtap="newline" disabled="{{sending || voice !== 'idle'}}"><image class="ui-icon" src="{{icons.newline}}" mode="aspectFit"/>换行</button></view><view class="row"><button size="mini" wx:if="{{running}}" class="stop-button" bindtap="stop"><image class="ui-icon" src="{{icons.stop}}" mode="aspectFit"/>停止</button><button size="mini" class="voice-button" bindtap="voiceTap" bindtouchstart="voiceHold" bindlongpress="voiceStart" bindtouchend="voiceRelease" bindtouchcancel="voiceCancel" catchtouchmove="voiceMove"><text wx:if="{{voice === 'recording'}}" class="record-dot">●</text><image wx:else class="ui-icon mic-icon" src="{{icons.voice}}" mode="aspectFit"/><text>按住说</text></button><button size="mini" class="send-button" loading="{{sending}}" disabled="{{sending || creatingSession || uploading || voice !== 'idle' || (insufficient && !voiceReady)}}" bindtap="send" aria-label="发送消息"><image class="ui-icon" src="{{onPrimary.send}}" mode="aspectFit"/></button></view></view>
    </view><view class="composer-note quiet">{{voice === 'idle' ? voiceLabel : '识别成功后才会执行指令'}} · 结果发布前请核验</view>
  </view>
</view>
<view wx:if="{{pick}}" class="picker-mask" bindtap="closePick"><view class="picker-sheet" catchtap="noop"><view class="page-heading"><text>选择素材</text><button size="mini" class="small-button" bindtap="closePick">完成</button></view><view class="row"><button size="mini" class="secondary grow" bindtap="upload"><image class="ui-icon" src="{{icons.upload}}" mode="aspectFit"/>相册 / 拍摄（可混选）</button><button size="mini" class="secondary grow" bindtap="upload" data-audio="yes"><image class="ui-icon" src="{{icons.upload}}" mode="aspectFit"/>聊天文件 / 音频</button></view><scroll-view scroll-y class="source-list"><view wx:if="{{!sources.length}}" class="empty"><text class="muted">还没有素材，可以先上传，也可以直接说出视频需求。</text></view><button size="mini" wx:for="{{sources}}" wx:key="id" class="source-row {{item.selected ? 'selected' : ''}}" bindtap="select" data-id="{{item.id}}"><image wx:if="{{item.cover}}" class="source-thumb" src="{{item.cover}}" mode="aspectFill" lazy-load data-id="{{item.id}}" binderror="sourceCoverError" /><text class="source-name">{{item.name}}</text><text class="tag">{{item.selected ? '已选' : item.kind === 'video' ? '视频' : item.kind === 'image' ? '图片' : '音频'}}</text></button></scroll-view><button size="mini" class="small-button" bindtap="livePhotoHelp">实况照片导入方法</button><view class="quiet">已选 {{attachmentIds.length}} / {{attachmentLimit}} · 图片和视频可一起选择</view></view></view>
<privacy-dialog id="privacy" />
<view wx:if="{{voiceConsentVisible}}" class="voice-consent-mask" catchtouchmove="noop">
  <view class="voice-consent-dialog" role="dialog" aria-modal="true" aria-label="声纹授权协议">
    <view class="voice-consent-heading">声纹授权协议</view>
    <view class="voice-consent-intro">使用语音录入前，请了解录音的收集与处理方式，并单独选择是否同意。</view>
    <scroll-view scroll-y class="voice-consent-terms">
      <view class="voice-consent-version">可上下滑动阅读 · 版本 {{voiceConsentVersion}}</view>
      <view wx:for="{{voiceConsentSections}}" wx:key="title" class="voice-consent-section"><view class="voice-consent-title">{{index + 1}}. {{item.title}}</view><view class="voice-consent-copy">{{item.text}}</view></view>
    </scroll-view>
    <view class="voice-consent-hint">同意后请再次按住说话，当前不会立即录音。</view>
    <view class="voice-consent-actions"><button size="mini" class="voice-consent-action voice-consent-cancel" bindtap="cancelConsent">暂不使用语音</button><button size="mini" class="voice-consent-action voice-consent-agree" bindtap="agreeVoiceConsent">同意语音授权</button></view>
  </view>
</view>

<view wx:if="{{sidebarOpen}}" class="sidebar-layer">
  <view class="sidebar-backdrop" bindtap="closeSidebar" catchtouchmove="noop"/>
  <view class="sidebar-drawer">
    <view class="sidebar-heading"><view class="sidebar-brand"><image src="/assets/lightmao-assistant.jpg" mode="aspectFill"/><text>轻喵</text></view><button size="mini" class="sidebar-toggle" bindtap="closeSidebar" aria-label="收起侧边栏"><image class="sidebar-glyph-image" src="{{theme === 'rich' ? '/assets/ui/sidebar-light.png' : '/assets/ui/sidebar-dark.png'}}" mode="aspectFit"/></button></view>
    <view class="sidebar-menu"><button size="mini" bindtap="sidebarNew" data-mode="chat"><image class="ui-icon" src="{{icons.newChat}}" mode="aspectFit"/><text>新对话</text></button><button size="mini" bindtap="sidebarNew" data-mode="work"><image class="ui-icon" src="{{icons.create}}" mode="aspectFit"/><text>新工作</text></button><button size="mini" bindtap="history"><image class="ui-icon" src="{{icons.history}}" mode="aspectFit"/><text>会话历史</text></button><button size="mini" bindtap="tasks"><image class="ui-icon" src="{{icons.settings}}" mode="aspectFit"/><text>定时任务</text></button></view>
    <input class="sidebar-search" placeholder="搜索会话" value="{{sidebarQuery}}" bindinput="sidebarSearch" maxlength="100"/>
    <view class="sidebar-filters"><button size="mini" class="{{sidebarFilter === 'all' ? 'chosen' : ''}}" bindtap="sidebarFilter" data-filter="all">全部</button><button size="mini" class="{{sidebarFilter === 'chat' ? 'chosen' : ''}}" bindtap="sidebarFilter" data-filter="chat">对话</button><button size="mini" class="{{sidebarFilter === 'work' ? 'chosen' : ''}}" bindtap="sidebarFilter" data-filter="work">工作</button><button size="mini" class="{{sidebarArchived ? 'chosen' : ''}}" bindtap="sidebarArchiveFilter">归档</button></view>
    <scroll-view class="sidebar-history" scroll-y>
      <view wx:if="{{!sidebarGroups.length}}" class="sidebar-empty">{{guest ? '登录后保存你的会话' : sidebarArchived ? '还没有归档会话' : '还没有匹配的会话'}}</view>
      <view wx:for="{{sidebarGroups}}" wx:for-item="group" wx:key="id" class="sidebar-group"><view class="sidebar-group-title">{{group.title}}</view><view wx:for="{{group.items}}" wx:for-item="session" wx:key="id" class="sidebar-session {{session.selected ? 'selected' : ''}}" bindtap="sidebarActivate" data-id="{{session.id}}"><image class="sidebar-session-icon" src="{{session.mode === 'chat' ? icons.newChat : icons.create}}" mode="aspectFit"/><text class="sidebar-session-title">{{session.title}}</text><button size="mini" class="sidebar-session-more" catchtap="sidebarActions" data-id="{{session.id}}" disabled="{{sidebarBusy}}" aria-label="管理会话">···</button></view></view>
      <button size="mini" wx:if="{{sidebarMore}}" class="sidebar-load-more" bindtap="sidebarMore">显示更多</button>
    </scroll-view>
    <button size="mini" class="sidebar-account" bindtap="profile"><image wx:if="{{userAvatar}}" src="{{userAvatar}}" mode="aspectFill" binderror="avatarError"/><view wx:else class="user-avatar-fallback">{{userInitial || '你'}}</view><text class="sidebar-account-name">{{guest ? '登录 / 我的' : userDisplayName}}</text><text class="sidebar-account-arrow">›</text></button>
  </view>
</view>
</view>
