local C = {cyan=vmath.vector4(.32,.88,1,1),gold=vmath.vector4(1,.76,.25,1),ink=vmath.vector4(.08,.13,.22,1),muted=vmath.vector4(.55,.68,.81,1)}
local function box(x,y,w,h,color)
 local node=gui.new_box_node(vmath.vector3(x,y,0),vmath.vector3(w,h,0));gui.set_color(node,color);return node
end
local function label(x,y,text,scale,color)
 local node=gui.new_text_node(vmath.vector3(x,y,0),text);gui.set_font(node,'default');gui.set_scale(node,vmath.vector3(scale,scale,1));gui.set_color(node,color);return node
end
local function clear_objects(self)
 for _,o in ipairs(self.drops or {}) do gui.delete_node(o.node) end
 for _,o in ipairs(self.particles or {}) do gui.delete_node(o.node) end
 self.drops={};self.particles={}
end
local function reset(self)
 clear_objects(self);self.x=480;self.score=0;self.missed=0;self.time=0;self.spawn=0;self.left=false;self.right=false
end
local function burst(self,x,y)
 for i=1,14 do
  local angle=i*math.pi*2/14
  local n=box(x,y,6,6,C.gold)
  table.insert(self.particles,{node=n,x=x,y=y,vx=math.cos(angle)*155,vy=math.sin(angle)*155,life=.65})
 end
 gui.animate(self.player,gui.PROP_SCALE,vmath.vector3(1.35,.8,1),gui.EASING_OUTQUAD,.12,0,function() gui.animate(self.player,gui.PROP_SCALE,vmath.vector3(1,1,1),gui.EASING_OUTBACK,.2) end)
end
function init(self)
 msg.post('.', 'acquire_input_focus');gui.set_render_order(1)
 self.player=box(480,80,76,22,C.cyan)
 self.halo=box(480,80,100,32,vmath.vector4(.15,.65,.9,.18))
 label(480,582,'TOKEN CATCHER',1.7,C.cyan)
 label(480,545,'Move with LEFT / RIGHT or touch. Catch the falling tokens.',.8,C.muted)
 self.score_label=label(146,486,'SCORE 0',1.15,C.gold)
 self.miss_label=label(804,486,'MISSED 0',.9,C.muted)
 label(480,25,'R = RESTART  |  built with Defold',.75,C.muted)
 self.restarts=0;self.input_count=0;reset(self)
end
function update(self,dt)
 self.time=self.time+dt
 if self.left then self.x=self.x-420*dt end
 if self.right then self.x=self.x+420*dt end
 self.x=math.max(60,math.min(900,self.x))
 gui.set_position(self.player,vmath.vector3(self.x,80,0));gui.set_position(self.halo,vmath.vector3(self.x,80,0))
 self.spawn=self.spawn+dt
 if self.spawn>.65 then
  self.spawn=self.spawn-.65
  local x=80+((#self.drops*173+math.floor(self.time*157))%800)
  local node=box(x,450,22,22,C.gold)
  table.insert(self.drops,{node=node,x=x,y=450,speed=145+math.floor(self.time)%5*15})
 end
 for i=#self.drops,1,-1 do
  local o=self.drops[i];o.y=o.y-o.speed*dt
  gui.set_position(o.node,vmath.vector3(o.x,o.y,0));gui.set_euler(o.node,vmath.vector3(0,0,self.time*120))
  if math.abs(o.x-self.x)<48 and math.abs(o.y-80)<25 then
   self.score=self.score+1;burst(self,o.x,o.y);gui.delete_node(o.node);table.remove(self.drops,i)
  elseif o.y<50 then self.missed=self.missed+1;gui.delete_node(o.node);table.remove(self.drops,i) end
 end
 for i=#self.particles,1,-1 do
  local o=self.particles[i];o.life=o.life-dt;o.x=o.x+o.vx*dt;o.y=o.y+o.vy*dt
  gui.set_position(o.node,vmath.vector3(o.x,o.y,0));gui.set_color(o.node,vmath.vector4(1,.76,.25,math.max(0,o.life/.65)))
  if o.life<=0 then gui.delete_node(o.node);table.remove(self.particles,i) end
 end
 gui.set_text(self.score_label,'SCORE '..self.score);gui.set_text(self.miss_label,'MISSED '..self.missed)
 if html5 then html5.run('window.__QJ_GAME_STATE='..json.encode({x=self.x,score=self.score,missed=self.missed,time=self.time,inputs=self.input_count,restarts=self.restarts,drops=#self.drops,particles=#self.particles})) end
end
function on_input(self,action_id,action)
 if action_id==hash('left') then self.left=not action.released;self.input_count=self.input_count+1
 elseif action_id==hash('right') then self.right=not action.released;self.input_count=self.input_count+1
 elseif action_id==hash('touch') and action.x then self.x=action.x;self.input_count=self.input_count+1
 elseif action_id==hash('restart') and action.pressed then self.restarts=self.restarts+1;reset(self) end
end
