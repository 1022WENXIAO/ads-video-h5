# Optional server environment variables. Export them before starting the API;
# this example file is not loaded automatically by pnpm dev.
PORT=8787
QINGJIAN_DATA_DIR=
# Optional model-storage encryption seed on first launch. No longer accepted as a login token.
QINGJIAN_ADMIN_TOKEN=
# Optional initial password for the default admin account (12-256 characters, first launch only).
# Otherwise reuse an existing admin-token as the migration password, or generate a random password.
# Read the bootstrap password locally from data/admin-initial-password. Never use VITE_* for credentials.
QINGJIAN_ADMIN_PASSWORD=
PUBLIC_BASE_PATH=
VITE_BASE_PATH=/
# Optional Alibaba OSS bucket. Configure all four together, or leave all empty for local storage.
# Set OSS_PUBLIC_READ=true only after the bucket allows anonymous reads and every media object is readable.
OSS_REGION=oss-ap-southeast-1
OSS_BUCKET=
OSS_PREFIX=qingjian
OSS_PUBLIC_READ=false
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# Registration email. Keep the key in a private server environment file, never in VITE_*.
RESEND_API_KEY=
RESEND_FROM=
# Configure model IDs, service URLs and API keys at /admin after launch.
# Optional open-webSearch 2.2 HTTP daemon. Leave empty to use Ark web_search.
# Keep the daemon on loopback; never expose its unauthenticated API publicly.
QINGJIAN_OPEN_WEBSEARCH_URL=
QINGJIAN_OPEN_WEBSEARCH_ENGINES=bing,baidu
# Default missing-date behavior for news without an explicit user time window.
# flexible: allow cross-checked undated bodies and display an unknown-date note.
# strict: always require a dated fresh core source. Explicit user windows stay strict.
QINGJIAN_NEWS_DATE_POLICY=flexible
# Preferred freshness window when the user did not specify one (1-720 hours).
QINGJIAN_NEWS_WINDOW_HOURS=72
