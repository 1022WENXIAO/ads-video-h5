{
  "name": "ads-video-h5",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "test": "node --import tsx --test tests/*.test.ts",
    "dev": "concurrently -k \"pnpm dev:server\" \"pnpm dev:web\" \"pnpm dev:admin\"",
    "dev:web": "vite --host 127.0.0.1",
    "dev:server": "tsx watch server/index.ts",
    "dev:admin": "pnpm --filter @qingjian/admin dev",
    "build:h5": "tsc --noEmit && vite build",
    "build:admin": "pnpm --filter @qingjian/admin build",
    "build:mini": "pnpm --filter @qingjian/miniprogram build",
    "build": "pnpm build:h5 && pnpm build:admin && node tooling/package-frontends.mjs",
    "start": "tsx server/index.ts",
    "eval:requests": "node --import tsx tooling/evaluate-requests.ts",
    "eval:workflow-entry": "node --import tsx tooling/evaluate-workflow-entry.ts",
    "eval:production": "node --import tsx tooling/evaluate-production.ts",
    "eval:recovery": "node --import tsx tooling/evaluate-recovery.ts",
    "eval:release": "node --import tsx tooling/release-acceptance.ts"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "^0.87.1",
    "@earendil-works/pi-ai": "^0.87.1",
    "ali-oss": "^6.23.0",
    "express": "^5.1.0",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "3.1.0",
    "gsap": "3.14.2",
    "hyperframes": "0.8.78",
    "lucide-react": "^0.468.0",
    "multer": "^2.0.2",
    "parse5": "8.0.1",
    "pinyin-pro": "3.29.4",
    "pngjs": "7.0.0",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typebox": "^1.0.50"
  },
  "devDependencies": {
    "@types/ali-oss": "^6.23.3",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.0.0",
    "@types/pngjs": "6.0.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.0",
    "playwright": "^1.63.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "packageManager": "pnpm@11.25.0"
}
