[Unit]
Description=Pull and deploy Qingjian main after a successful build
Wants=network-online.target
After=network-online.target
RequiresMountsFor=/data/qingjian

[Service]
Type=oneshot
EnvironmentFile=/etc/qingjian/oss.env
ExecStart=/usr/local/sbin/qingjian-cd
TimeoutStartSec=9h
TimeoutStopSec=180
UMask=0077
