#!/usr/bin/env bash
set -Eeuo pipefail
# The runtime service is a separate user and must be able to read checked-out files.
umask 022

repo=/opt/ads-video-h5
cache=/var/cache/qingjian-cd
build_user=qingjian-build
build_dir=
backup_dir=
browser_staging=
previous_sha=
target_sha=
switched=0

mkdir -p "$cache"
exec 9>/run/lock/qingjian-cd.lock
flock -n 9 || exit 0

finish() {
  local status=$?
  trap - EXIT
  if (( status != 0 )) && [[ "$target_sha" =~ ^[0-9a-f]{40}$ ]]; then
    printf '%s\n' "$target_sha" > "$cache/rejected-sha.next"
    mv "$cache/rejected-sha.next" "$cache/rejected-sha"
    echo "Release ${target_sha:0:12} rejected; automatic retries wait for a new commit or explicit operator retry." >&2
  fi
  if (( status != 0 && switched == 1 )); then
    echo "Deploy failed; restoring ${previous_sha:0:12}" >&2
    git -C "$repo" checkout --detach --quiet "$previous_sha" || true
    # Checkout/preflight can fail before the dependency swap. In that case
    # the live dependencies are still the original ones and must stay put.
    if [[ -d "$backup_dir/node_modules" ]]; then
      if [[ -d "$repo/node_modules" ]]; then mv "$repo/node_modules" "$build_dir/failed-node-modules"; fi
      mv "$backup_dir/node_modules" "$repo/node_modules"
    fi
    if [[ -n "$backup_dir" && -d "$backup_dir/dist" ]]; then
      if [[ -d "$repo/dist" ]]; then mv "$repo/dist" "$build_dir/failed-dist"; fi
      mv "$backup_dir/dist" "$repo/dist"
    fi
    systemctl restart qingjian || true
  fi
  if [[ "$build_dir" == "$cache"/build.* && -d "$build_dir" ]]; then rm -rf -- "$build_dir"; fi
  if [[ "$backup_dir" == "$cache"/backup.* && -d "$backup_dir" ]]; then rm -rf -- "$backup_dir"; fi
  if [[ "$browser_staging" == "$cache"/browser-staging.* && -d "$browser_staging" ]]; then rm -rf -- "$browser_staging"; fi
  exit "$status"
}
trap finish EXIT

if [[ -n "$(git -C "$repo" status --porcelain)" ]]; then
  echo 'Live checkout has local changes; deployment stopped.' >&2
  exit 1
fi

git -C "$repo" fetch --quiet origin main
target_sha=$(git -C "$repo" rev-parse refs/remotes/origin/main)
previous_sha=$(git -C "$repo" rev-parse HEAD)
if [[ "$target_sha" == "$previous_sha" ]]; then
  echo "Already deployed ${target_sha:0:12}"
  exit 0
fi
if [[ -f "$cache/rejected-sha" && "$(cat "$cache/rejected-sha")" == "$target_sha" ]]; then
  echo "Release ${target_sha:0:12} previously failed deployment acceptance; waiting for a new commit or explicit operator retry."
  exit 0
fi
if ! git -C "$repo" merge-base --is-ancestor "$previous_sha" "$target_sha"; then
  echo 'Remote main is not a fast-forward of the deployed commit; deployment stopped.' >&2
  exit 1
fi

build_dir=$(mktemp -d "$cache/build.XXXXXXXX")
git -C "$repo" archive "$target_sha" | tar -x -C "$build_dir"
install -d -o "$build_user" -g "$build_user" -m 0755 "$cache/home" "$cache/home/.cache"
# Real HTML tests need a browser before HyperFrames runs. Bind an installed
# system browser, or copy only the runtime's browser bundle out of its private
# cache. Never grant the build user access to production accounts or media,
# and never let a test silently download a browser under a different HOME.
test_browser=
for candidate in "${HYPERFRAMES_BROWSER_PATH:-}" \
  /usr/bin/google-chrome /usr/bin/google-chrome-stable /usr/bin/chromium /usr/bin/chromium-browser \
  /data/qingjian/.cache/hyperframes/chrome/chrome-headless-shell/linux-*/chrome-headless-shell-linux64/chrome-headless-shell \
  /data/qingjian/.cache/puppeteer/chrome-headless-shell/linux-*/chrome-headless-shell-linux64/chrome-headless-shell; do
  [[ -n "$candidate" && -f "$candidate" && -x "$candidate" ]] || continue
  if runuser -u "$build_user" -- test -x "$candidate"; then
    test_browser=$candidate
    break
  fi
  candidate=$(readlink -f "$candidate")
  [[ "$candidate" == /data/qingjian/.cache/*/chrome-headless-shell/linux-*/chrome-headless-shell-linux64/chrome-headless-shell ]] || continue
  browser_hash=$(sha256sum "$candidate" | cut -d' ' -f1)
  browser_bundle="$cache/browser-$browser_hash"
  if [[ ! -x "$browser_bundle/chrome-headless-shell" ]]; then
    browser_staging=$(mktemp -d "$cache/browser-staging.XXXXXXXX")
    cp -a "$(dirname "$candidate")/." "$browser_staging/"
    chmod -R a+rX "$browser_staging"
    mv "$browser_staging" "$browser_bundle"
    browser_staging=
  fi
  test_browser="$browser_bundle/chrome-headless-shell"
  break
done
if [[ -z "$test_browser" ]]; then
  echo 'Real HTML regression tests require an existing browser readable by the isolated build user.' >&2
  exit 1
fi
runuser -u "$build_user" -- "$test_browser" --version
chown -R "$build_user:$build_user" "$build_dir"
runuser -u "$build_user" -- env -i PATH="$PATH" HOME="$cache/home" XDG_CACHE_HOME="$cache/home/.cache" \
  HYPERFRAMES_BROWSER_PATH="$test_browser" PRODUCER_HEADLESS_SHELL_PATH="$test_browser" \
  bash -c 'cd "$1" && pnpm install --frozen-lockfile && node --import tsx --test --test-concurrency=2 tests/*.test.ts && VITE_BASE_PATH=/qingjian/ pnpm build' _ "$build_dir"
test -f "$build_dir/dist/index.html"
test -f "$build_dir/dist/admin/index.html"
# The oneshot unit has UMask=0077. Allow the separate runtime user to traverse
# pnpm's virtual store and read the built assets after the directory swap.
chmod -R a+rX "$build_dir/node_modules" "$build_dir/dist"

backup_dir=$(mktemp -d "$cache/backup.XXXXXXXX")
if [[ -d "$repo/dist" ]]; then cp -a "$repo/dist" "$backup_dir/dist"; fi
switched=1
git -C "$repo" checkout --detach --quiet "$target_sha"
if [[ -d "$repo/node_modules" ]]; then mv "$repo/node_modules" "$backup_dir/node_modules"; fi
mv "$build_dir/node_modules" "$repo/node_modules"
if [[ -d "$repo/dist" ]]; then mv "$repo/dist" "$build_dir/old-dist"; fi
mv "$build_dir/dist" "$repo/dist"
chown -R root:root "$repo/dist" "$repo/node_modules"
# Check the actual runtime user's native dependency access before restarting.
# A root-only esbuild binary can otherwise leave a cached process working but
# make the next startup fail.
(cd "$repo" && runuser -u qingjian -- node --input-type=module -e '
  const { createRequire } = await import("node:module");
  const require = createRequire(process.argv[1] + "/package.json");
  createRequire(require.resolve("tsx/package.json"))("esbuild").transformSync("const checked = true", {loader:"js"});
' "$repo")
systemctl restart qingjian

healthy=0
for _ in $(seq 1 30); do
  if node --input-type=module -e 'const h=await fetch("http://127.0.0.1:8787/api/health",{signal:AbortSignal.timeout(4000)}).then(r=>r.json());if(!h.ok||h.revision!==process.argv[1])process.exit(1)' "$target_sha" \
    && curl --fail --silent --output /dev/null http://127.0.0.1:8787/qingjian/ \
    && curl --fail --silent http://127.0.0.1:8787/admin/ | grep -q '管理控制台'; then
    healthy=1
    break
  fi
  sleep 1
done
if (( healthy != 1 )); then
  echo 'New release did not pass local API, H5 and admin checks.' >&2
  exit 1
fi
# This reads only private server-side acceptance records. It does not create
# administrator sessions or expose a deployment bypass over HTTP.
(cd "$repo" && runuser -u qingjian -- node --import tsx tooling/release-acceptance.ts --data-dir /data/qingjian --revision "$target_sha")
node --input-type=module -e 'const h=await fetch("http://127.0.0.1:8787/api/health",{signal:AbortSignal.timeout(4000)}).then(r=>r.json());if(!h.ok||h.revision!==process.argv[1])process.exit(1)' "$target_sha"
switched=0
echo "Deployed $target_sha"
