[Unit]
Description=Qingjian Ant-Browser (local Launch API)
After=network.target

[Service]
Type=simple
User=qingjian-ant-browser
Group=qingjian-ant-browser
WorkingDirectory=/opt/ant-browser/current
Environment=HOME=/data/ant-browser
Environment=GDK_BACKEND=x11
Environment=WEBKIT_DISABLE_COMPOSITING_MODE=1
Environment=NO_AT_BRIDGE=1
ExecStart=/usr/bin/xvfb-run -a -s "-screen 0 1280x900x24 -nolisten tcp" /opt/ant-browser/current/ant-chrome
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillMode=control-group
MemoryAccounting=true
MemoryHigh=512M
MemoryMax=768M
MemorySwapMax=512M
CPUQuota=100%
TasksMax=512
OOMPolicy=stop
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/opt/ant-browser/releases/1.8.0 /etc/ant-browser
UMask=0077

[Install]
WantedBy=multi-user.target
